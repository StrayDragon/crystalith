{
  "name": "@crystalith/slidev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/ensure-preview.mjs && slidev ../../../data/output/preview/slides.md --port 3030 --open false --theme @slidev/theme-default",
