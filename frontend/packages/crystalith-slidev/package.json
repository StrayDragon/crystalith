    "export": "slidev export ../../../data/output/preview/slides.md"
  },
  "devDependencies": {
    "@slidev/cli": "^0.49.0",
    "@slidev/theme-default": "^0.25.0"
  },
  "packageManager": "pnpm@10.29.2"
}
