{
  "name": "@crystalith/slidev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/ensure-preview.mjs && slidev ../../../data/output/preview/slides.md --port 3030 --open false --theme @slidev/theme-default",
    "build": "node scripts/ensure-preview.mjs && slidev build ../../../data/output/preview/slides.md --out dist --theme @slidev/theme-default",
    "export": "node scripts/ensure-preview.mjs && slidev export ../../../data/output/preview/slides.md --theme @slidev/theme-default"
  },
  "devDependencies": {
    "@slidev/cli": "^0.49.0",
    "@slidev/theme-default": "^0.25.0",
    "playwright-chromium": "^1.58.2"
  },
  "packageManager": "pnpm@10.29.2"
}
