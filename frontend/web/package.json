{
  "name": "crystalith-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.29.2",
  "dependencies": {
    "@material-tailwind/react": "^2.1.10",
    "@mui/icons-material": "^7.3.7",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^13.5.0",
    "@xyflow/react": "^12.10.0",
    "gridstack": "^12.4.2",
    "jspdf": "^4.1.0",
    "pptxgenjs": "^4.0.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-virtuoso": "^4.18.1",
    "swr": "^2.3.6",
    "zustand": "^5.0.10"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "biome lint --changed --no-errors-on-unmatched ./src",
    "lint:all": "biome lint ./src",
    "test": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "api:generate": "openapi-ts -i ./openapi.json -o ./src/api/generated -c @hey-api/client-fetch",
    "api:fetch": "cd ../../backend/py && uv run scripts/api_schema.py export -o ../../frontend/web/openapi.json",
    "api:sync": "pnpm run api:fetch && pnpm run api:generate",
    "api:check": "cd ../../backend/py && uv run scripts/api_schema.py check -s ../../frontend/web/openapi.json"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.90.8",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.8",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.23",
    "@biomejs/biome": "^1.9.4",
    "jsdom": "^26.1.0",
    "msw": "^2.12.10",
    "postcss": "^8.5.6",
    "tailwind-scrollbar": "^3.1.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
