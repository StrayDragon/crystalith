{
  "plugins": ["react", "import", "vitest", "jsx-a11y"],
  "ignorePatterns": [
    "dist/**",
    "coverage/**",
    "node_modules/**",
    "vendor/**",
    "src/api/generated/**",
    "openapi.gen.json"
  ],
  "rules": {
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css", "@testing-library/jest-dom/vitest", "**/api/setup"]
      }
    ]
  }
}
