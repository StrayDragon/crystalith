# Optional secrets file for Crystalith.
#
# Usage:
# - Copy to `config/secrets.yaml`
# - (Optional) Set `CRYSTALITH_SECRETS_PATH=config/secrets.yaml` (or mount it in Docker)
#   - If unset, the backend will auto-discover `config/secrets.yaml` next to `config/app.yaml`.
#
# This file is read by ConfigManager for ${{ secrets.VAR }} interpolation.
#
# Do NOT commit `config/secrets.yaml`.
#
# Note (Docker Compose):
# - The `api` container runs as a non-root user and bind-mounts `./config` read-only.
# - Ensure `config/secrets.yaml` is readable by the container user (e.g. keep default 0644),
#   or set `CRYSTALITH_SECRETS_PATH` to a Docker-secrets directory mount.

OPENAI_API_KEY: "sk-..."

# Optional: API auth key when `app.auth.enabled=true`
# CRYSTALITH_API_KEY: "..."

# Optional: dev defaults (compose overlays use the same default user/db name).
# POSTGRES_PASSWORD: "crystalith"

# Optional: web extraction providers
# JINA_API_KEY: "..."
# FIRECRAWL_API_KEY: "..."
