# Crystalith secrets (dotenv format)
#
# Usage:
#   cp config/secret.env.example config/secret.env
#   # then edit config/secret.env (DO NOT COMMIT)
#
# The backend auto-loads `config/secret.env` and exposes it to config templates as:
#   {{ secret.KEY }}
#
# Notes:
# - Keep secrets OUT of `.env` (which is for compose/build params + non-secret template inputs).
# - Missing optional keys can be left empty.

# Required for OpenAI models in the default config.
OPENAI_API_KEY=

# Optional: API auth key when `app.auth.enabled=true`
CRYSTALITH_API_KEY=

# Optional: dev defaults (compose overlays use the same default user/db name).
POSTGRES_PASSWORD=

# Optional: web extraction providers
JINA_API_KEY=
FIRECRAWL_API_KEY=
BROWSERLESS_TOKEN=
