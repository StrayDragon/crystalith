# Regenerate hints:
#   just gen-env-examples

# LLM 聊天 API 密钥。推荐通过 ~/.bashrc 导出 CL_CHAT_API_KEY 环境变量。
CL_CHAT_API_KEY=

# LLM 嵌入 API 密钥。推荐通过 ~/.bashrc 导出 CL_EMBEDDING_API_KEY 环境变量。
CL_EMBEDDING_API_KEY=

# Crystalith 自托管 API 密钥（可选）。启用 app.auth 时用于 Bearer 认证。
CRYSTALITH_API_KEY=

# OpenAI API 密钥。用于直接 OpenAI 调用（非 gateway）。
OPENAI_API_KEY=

# Anthropic API 密钥。用于直接 Anthropic 调用。
ANTHROPIC_API_KEY=

# Google Generative AI API 密钥。用于直接 Google 调用。
GOOGLE_GENERATIVE_AI_API_KEY=
