      "type": "string"
    },
    "schema": {
      "default": "v1",
      "description": "Schema version",
      "title": "Schema",
      "type": "string"
    },
    "providers": {
      "additionalProperties": true,
      "description": "Reusable provider configurations (use YAML anchors)",
      "title": "Providers",
      "type": "object"
    },
    "app": {
      "$ref": "#/$defs/AppSettings"
    },
    "database": {
