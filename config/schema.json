{
  "$defs": {
    "AISettings": {
      "description": "AI provider runtime settings.",
      "properties": {
        "timeout": {
          "default": 60,
          "description": "Provider request timeout in seconds",
          "maximum": 600,
          "minimum": 1,
          "title": "Timeout",
          "type": "integer"
        },
        "max_retries": {
          "default": 3,
          "description": "Maximum retries for retryable provider errors",
          "maximum": 10,
          "minimum": 0,
          "title": "Max Retries",
          "type": "integer"
        }
      },
      "title": "AISettings",
      "type": "object"
    },
    "AppSettings": {
      "description": "Application settings.",
      "properties": {
        "name": {
          "default": "Crystalith",
          "title": "Name",
          "type": "string"
        },
        "openapi_path": {
          "default": "/v1/codev/openapi.json",
          "title": "Openapi Path",
          "type": "string"
        },
        "openapi_ui_path": {
          "default": "/v1/codev/openapi-ui/scalar",
          "title": "Openapi Ui Path",
          "type": "string"
        }
      },
      "title": "AppSettings",
      "type": "object"
    },
    "BrowserlessSettings": {
      "description": "Browserless 浏览器渲染提取器配置。",
      "properties": {
        "enabled": {
          "default": false,
          "description": "是否启用 Browserless 提取器",
          "title": "Enabled",
          "type": "boolean"
        },
        "endpoint": {
          "default": "ws://localhost:3000",
          "description": "Browserless WebSocket 端点",
          "title": "Endpoint",
          "type": "string"
        },
        "token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "认证令牌（可选）",
          "title": "Token"
        },
        "timeout": {
          "default": 60,
          "description": "页面加载超时时间（秒）",
          "maximum": 300,
          "minimum": 10,
          "title": "Timeout",
          "type": "integer"
        },
        "wait_until": {
          "default": "networkidle",
          "description": "页面等待条件",
          "enum": [
            "load",
            "domcontentloaded",
            "networkidle"
          ],
          "title": "Wait Until",
          "type": "string"
        }
      },
      "title": "BrowserlessSettings",
      "type": "object"
    },
    "ChatSettings": {
      "description": "Chat settings.\n\nUse models.defaults.chat to specify the default chat model.\nThis section only contains chat-specific options.",
      "properties": {},
      "title": "ChatSettings",
      "type": "object"
    },
    "CompletionOptions": {
      "description": "Default completion options for model inference.\n\nSimilar to Continue's defaultCompletionOptions.",
      "properties": {
        "context_length": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Maximum context length (tokens)",
          "title": "Context Length"
        },
        "max_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Maximum tokens to generate",
          "title": "Max Tokens"
        },
        "temperature": {
          "anyOf": [
            {
              "maximum": 2.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Sampling temperature",
          "title": "Temperature"
        },
        "top_p": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Nucleus sampling probability",
          "title": "Top P"
        },
        "top_k": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Top-k sampling",
          "title": "Top K"
        },
        "stop": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Stop sequences",
          "title": "Stop"
        },
        "reasoning": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Enable reasoning/thinking mode",
          "title": "Reasoning"
        }
      },
      "title": "CompletionOptions",
      "type": "object"
    },
    "ContextWindowSettings": {
      "description": "Context window management settings.",
      "properties": {
        "max_tokens": {
          "default": 8000,
          "minimum": 1,
          "title": "Max Tokens",
          "type": "integer"
        },
        "compression_strategy": {
          "default": "truncate",
          "enum": [
            "truncate",
            "summarize"
          ],
          "title": "Compression Strategy",
          "type": "string"
        },
        "window_size": {
          "default": 10,
          "minimum": 0,
          "title": "Window Size",
          "type": "integer"
        },
        "priority": {
          "items": {
            "enum": [
              "history",
              "retrieval",
              "recent",
              "system"
            ],
            "type": "string"
          },
          "title": "Priority",
          "type": "array"
        }
      },
      "title": "ContextWindowSettings",
      "type": "object"
    },
    "DatabaseSettings": {
      "description": "Database settings.",
      "properties": {
        "url": {
          "default": "sqlite+aiosqlite:///./data/app.db",
          "title": "Url",
          "type": "string"
        }
      },
      "title": "DatabaseSettings",
      "type": "object"
    },
    "EmbeddingSettings": {
      "description": "Embedding settings.\n\nUse models.defaults.embedding to specify the default embedding model.\nThis section only contains embedding-specific options.",
      "properties": {
        "chunk_size": {
          "default": 512,
          "description": "Default chunk size for embedding",
          "minimum": 64,
          "title": "Chunk Size",
          "type": "integer"
        },
        "batch_size": {
          "default": 32,
          "description": "Batch size for embedding requests",
          "minimum": 1,
          "title": "Batch Size",
          "type": "integer"
        }
      },
      "title": "EmbeddingSettings",
      "type": "object"
    },
    "FirecrawlSettings": {
      "description": "Firecrawl API 提取器配置。",
      "properties": {
        "enabled": {
          "default": false,
          "description": "是否启用 Firecrawl 提取器",
          "title": "Enabled",
          "type": "boolean"
        },
        "api_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Firecrawl API 密钥",
          "title": "Api Key"
        },
        "timeout": {
          "default": 60,
          "description": "请求超时时间（秒）",
          "maximum": 300,
          "minimum": 10,
          "title": "Timeout",
          "type": "integer"
        }
      },
      "title": "FirecrawlSettings",
      "type": "object"
    },
    "HttpProxySettings": {
      "description": "HTTP 代理配置。\n\n支持 HTTP/HTTPS/SOCKS5 代理协议，可作为 YAML anchor 被其他功能引用。\n\nExample:\n    proxy_settings: &default_proxy\n      enabled: false\n      http_url: \"http://127.0.0.1:7890\"\n      https_url: \"http://127.0.0.1:7890\"\n      socks5_url: null\n      no_proxy: [\"localhost\", \"127.0.0.1\"]\n\n    source_ingestion:\n      url_fetch:\n        proxy: *default_proxy",
      "properties": {
        "enabled": {
          "default": false,
          "description": "是否启用代理",
          "title": "Enabled",
          "type": "boolean"
        },
        "http_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "HTTP 代理 URL (例如 http://127.0.0.1:7890)",
          "title": "Http Url"
        },
        "https_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "HTTPS 代理 URL (可选，默认使用 http_url)",
          "title": "Https Url"
        },
        "socks5_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "SOCKS5 代理 URL (例如 socks5://127.0.0.1:1080)",
          "title": "Socks5 Url"
        },
        "no_proxy": {
          "description": "不走代理的域名/IP列表",
          "items": {
            "type": "string"
          },
          "title": "No Proxy",
          "type": "array"
        }
      },
      "title": "HttpProxySettings",
      "type": "object"
    },
    "JinaSettings": {
      "description": "Jina Reader API 提取器配置。",
      "properties": {
        "enabled": {
          "default": true,
          "description": "是否启用 Jina Reader 提取器",
          "title": "Enabled",
          "type": "boolean"
        },
        "api_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Jina API 密钥（可选，用于更高配额）",
          "title": "Api Key"
        },
        "timeout": {
          "default": 30,
          "description": "请求超时时间（秒）",
          "maximum": 120,
          "minimum": 5,
          "title": "Timeout",
          "type": "integer"
        },
        "proxy": {
          "anyOf": [
            {
              "$ref": "#/$defs/HttpProxySettings"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "代理配置（可选）"
        }
      },
      "title": "JinaSettings",
      "type": "object"
    },
    "ModelConfig": {
      "description": "Configuration for a single AI model.\n\nInspired by Continue's model configuration with enhancements for Crystalith.\n\nExample:\n    - id: \"gpt-5.2\"\n      provider: \"openai\"\n      model: \"gpt-5.2\"\n      display_name: \"GPT-5.2\"\n      description: \"Latest OpenAI model\"\n      roles: [chat, edit]\n      capabilities: [tool_use, image_input]\n      provider_config:\n        <<: *openai_main\n      completion_options:\n        temperature: 0.7\n        max_tokens: 4096",
      "properties": {
        "id": {
          "description": "Unique identifier for the model",
          "title": "Id",
          "type": "string"
        },
        "provider": {
          "description": "Provider type",
          "enum": [
            "openai",
            "ollama"
          ],
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "description": "Model name/identifier used by the provider",
          "title": "Model",
          "type": "string"
        },
        "display_name": {
          "description": "Human-readable display name",
          "title": "Display Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "description": "Optional description",
          "title": "Description",
          "type": "string"
        },
        "roles": {
          "description": "Roles this model can fulfill: chat, embed, edit, apply, autocomplete, summarize",
          "items": {
            "enum": [
              "chat",
              "embed",
              "edit",
              "apply",
              "autocomplete",
              "summarize"
            ],
            "type": "string"
          },
          "title": "Roles",
          "type": "array"
        },
        "capabilities": {
          "description": "Special capabilities: tool_use, image_input, audio_input, streaming",
          "items": {
            "anyOf": [
              {
                "enum": [
                  "tool_use",
                  "image_input",
                  "audio_input",
                  "streaming"
                ],
                "type": "string"
              },
              {
                "enum": [
                  "chat",
                  "embedding"
                ],
                "type": "string"
              }
            ]
          },
          "title": "Capabilities",
          "type": "array"
        },
        "provider_config": {
          "anyOf": [
            {
              "$ref": "#/$defs/OpenAIProviderSettings"
            },
            {
              "$ref": "#/$defs/OllamaProviderSettings"
            },
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Provider-specific configuration (can reference providers via anchors)",
          "title": "Provider Config"
        },
        "completion_options": {
          "anyOf": [
            {
              "$ref": "#/$defs/CompletionOptions"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Default completion options for this model"
        },
        "ollama_options": {
          "anyOf": [
            {
              "$ref": "#/$defs/OllamaRuntimeOptions"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Ollama-specific runtime options"
        },
        "request_options": {
          "anyOf": [
            {
              "$ref": "#/$defs/RequestOptions"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "HTTP request options"
        }
      },
      "required": [
        "id",
        "provider",
        "model",
        "display_name"
      ],
      "title": "ModelConfig",
      "type": "object"
    },
    "ModelDefaults": {
      "description": "Default model selections.",
      "properties": {
        "chat": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Default model ID for chat/generation",
          "title": "Chat"
        },
        "embedding": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Default model ID for embeddings",
          "title": "Embedding"
        },
        "edit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Default model ID for code editing",
          "title": "Edit"
        },
        "autocomplete": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Default model ID for autocomplete",
          "title": "Autocomplete"
        }
      },
      "title": "ModelDefaults",
      "type": "object"
    },
    "ModelsSettings": {
      "description": "Multi-model configuration settings.\n\nAll models must be defined in `available` list with unique IDs.\nUse `defaults` to specify which model to use for each role.\n\nExample:\n    models:\n      defaults:\n        chat: \"gpt-5.2\"\n        embedding: \"bge-m3-local\"\n      available:\n        - id: \"gpt-5.2\"\n          provider: \"openai\"\n          model: \"gpt-5.2\"\n          roles: [chat, edit]",
      "properties": {
        "defaults": {
          "$ref": "#/$defs/ModelDefaults"
        },
        "available": {
          "items": {
            "$ref": "#/$defs/ModelConfig"
          },
          "title": "Available",
          "type": "array"
        }
      },
      "title": "ModelsSettings",
      "type": "object"
    },
    "OllamaProviderSettings": {
      "description": "Ollama provider settings.",
      "properties": {
        "host": {
          "default": "http://localhost:11434",
          "title": "Host",
          "type": "string"
        }
      },
      "title": "OllamaProviderSettings",
      "type": "object"
    },
    "OllamaRuntimeOptions": {
      "description": "Ollama model runtime options.",
      "properties": {
        "num_ctx": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Num Ctx"
        },
        "num_thread": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "const": "auto",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Num Thread"
        },
        "temperature": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature"
        },
        "num_batch": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Num Batch"
        },
        "mlock": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mlock"
        },
        "numa": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Numa"
        },
        "low_vram": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Low Vram"
        }
      },
      "title": "OllamaRuntimeOptions",
      "type": "object"
    },
    "OpenAIProviderSettings": {
      "description": "OpenAI-compatible provider settings.",
      "properties": {
        "api_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Api Key"
        },
        "base_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base Url"
        },
        "organization": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Organization"
        },
        "project": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project"
        }
      },
      "title": "OpenAIProviderSettings",
      "type": "object"
    },
    "RefineSettings": {
      "description": "Content refinement settings.",
      "properties": {
        "formats": {
          "items": {
            "type": "string"
          },
          "title": "Formats",
          "type": "array"
        }
      },
      "title": "RefineSettings",
      "type": "object"
    },
    "RequestOptions": {
      "description": "HTTP request options for model API calls.",
      "properties": {
        "timeout": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Request timeout in seconds",
          "title": "Timeout"
        },
        "verify_ssl": {
          "default": true,
          "description": "Verify SSL certificates",
          "title": "Verify Ssl",
          "type": "boolean"
        },
        "proxy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Proxy URL",
          "title": "Proxy"
        },
        "headers": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Custom headers",
          "title": "Headers"
        }
      },
      "title": "RequestOptions",
      "type": "object"
    },
    "SearXNGSettings": {
      "description": "SearXNG search engine settings.",
      "properties": {
        "host": {
          "default": "http://localhost:8888",
          "description": "SearXNG instance URL",
          "title": "Host",
          "type": "string"
        },
        "api_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional API key for authentication",
          "title": "Api Key"
        },
        "timeout": {
          "default": 10,
          "description": "Request timeout in seconds",
          "minimum": 1,
          "title": "Timeout",
          "type": "integer"
        },
        "max_results": {
          "default": 10,
          "description": "Maximum number of results",
          "maximum": 50,
          "minimum": 1,
          "title": "Max Results",
          "type": "integer"
        }
      },
      "title": "SearXNGSettings",
      "type": "object"
    },
    "SearchSettings": {
      "description": "Web search settings.",
      "properties": {
        "searxng": {
          "$ref": "#/$defs/SearXNGSettings"
        }
      },
      "title": "SearchSettings",
      "type": "object"
    },
    "SourceIngestionSettings": {
      "description": "来源导入配置。",
      "properties": {
        "url_fetch": {
          "$ref": "#/$defs/UrlFetchSettings",
          "description": "URL 获取配置"
        },
        "web_extraction": {
          "$ref": "#/$defs/WebExtractionSettings",
          "description": "网页内容提取配置"
        }
      },
      "title": "SourceIngestionSettings",
      "type": "object"
    },
    "TrafilaturaSettings": {
      "description": "Trafilatura 本地提取器配置。",
      "properties": {
        "enabled": {
          "default": true,
          "description": "是否启用 Trafilatura 提取器",
          "title": "Enabled",
          "type": "boolean"
        },
        "include_tables": {
          "default": true,
          "description": "是否提取表格",
          "title": "Include Tables",
          "type": "boolean"
        },
        "include_links": {
          "default": true,
          "description": "是否提取链接",
          "title": "Include Links",
          "type": "boolean"
        },
        "output_format": {
          "default": "markdown",
          "description": "输出格式",
          "enum": [
            "markdown",
            "txt",
            "xml",
            "json"
          ],
          "title": "Output Format",
          "type": "string"
        },
        "timeout": {
          "default": 30,
          "description": "请求超时时间（秒）",
          "maximum": 120,
          "minimum": 5,
          "title": "Timeout",
          "type": "integer"
        },
        "proxy": {
          "anyOf": [
            {
              "$ref": "#/$defs/HttpProxySettings"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "代理配置（可选）"
        }
      },
      "title": "TrafilaturaSettings",
      "type": "object"
    },
    "UrlFetchSettings": {
      "description": "URL 内容获取配置。",
      "properties": {
        "proxy": {
          "$ref": "#/$defs/HttpProxySettings",
          "description": "代理配置"
        },
        "timeout": {
          "default": 30,
          "description": "请求超时时间（秒）",
          "maximum": 120,
          "minimum": 5,
          "title": "Timeout",
          "type": "integer"
        },
        "retry_count": {
          "default": 2,
          "description": "重试次数",
          "maximum": 5,
          "minimum": 0,
          "title": "Retry Count",
          "type": "integer"
        },
        "retry_delay": {
          "default": 1.0,
          "description": "重试间隔（秒）",
          "maximum": 10.0,
          "minimum": 0.0,
          "title": "Retry Delay",
          "type": "number"
        }
      },
      "title": "UrlFetchSettings",
      "type": "object"
    },
    "VectorStorageChromaSettings": {
      "description": "Chroma vector storage settings.",
      "properties": {
        "path": {
          "default": "./data/chroma",
          "title": "Path",
          "type": "string"
        },
        "telemetry": {
          "default": false,
          "title": "Telemetry",
          "type": "boolean"
        },
        "host": {
          "default": "localhost",
          "title": "Host",
          "type": "string"
        },
        "port": {
          "default": 8000,
          "title": "Port",
          "type": "integer"
        }
      },
      "title": "VectorStorageChromaSettings",
      "type": "object"
    },
    "VectorStorageSQLiteSettings": {
      "description": "SQLite vector storage settings.",
      "properties": {
        "path": {
          "default": "./data/vectors.db",
          "title": "Path",
          "type": "string"
        }
      },
      "title": "VectorStorageSQLiteSettings",
      "type": "object"
    },
    "VectorStorageSettings": {
      "description": "Vector storage settings.",
      "properties": {
        "provider": {
          "default": "chroma",
          "enum": [
            "memory",
            "sqlite",
            "chroma"
          ],
          "title": "Provider",
          "type": "string"
        },
        "sqlite": {
          "$ref": "#/$defs/VectorStorageSQLiteSettings"
        },
        "chroma": {
          "$ref": "#/$defs/VectorStorageChromaSettings"
        }
      },
      "title": "VectorStorageSettings",
      "type": "object"
    },
    "WebExtractionSettings": {
      "description": "网页内容提取配置。\n\n支持多种提取策略，按优先级自动降级：\n1. trafilatura - 本地提取，速度快，无需外部服务\n2. jina - Jina Reader API，免费且支持 JS 渲染\n3. firecrawl - 外部 API，功能强大，需要 API 密钥\n4. browserless - 浏览器渲染，适合复杂动态页面，需要服务\n\nExample:\n    web_extraction:\n      fallback_order: [\"trafilatura\", \"jina\", \"firecrawl\", \"browserless\"]\n      trafilatura:\n        enabled: true\n        output_format: \"markdown\"\n      jina:\n        enabled: true\n      firecrawl:\n        enabled: false\n        api_key: \"fc-xxx\"\n      browserless:\n        enabled: false\n        endpoint: \"ws://localhost:3000\"",
      "properties": {
        "fallback_order": {
          "description": "提取器降级顺序（按优先级排列）",
          "items": {
            "type": "string"
          },
          "title": "Fallback Order",
          "type": "array"
        },
        "enable_fallback": {
          "default": true,
          "description": "是否启用自动降级",
          "title": "Enable Fallback",
          "type": "boolean"
        },
        "trafilatura": {
          "$ref": "#/$defs/TrafilaturaSettings",
          "description": "Trafilatura 本地提取器配置"
        },
        "jina": {
          "$ref": "#/$defs/JinaSettings",
          "description": "Jina Reader API 提取器配置"
        },
        "firecrawl": {
          "$ref": "#/$defs/FirecrawlSettings",
          "description": "Firecrawl API 提取器配置"
        },
        "browserless": {
          "$ref": "#/$defs/BrowserlessSettings",
          "description": "Browserless 浏览器渲染提取器配置"
        }
      },
      "title": "WebExtractionSettings",
      "type": "object"
    }
  },
  "description": "Configuration schema for Crystalith. Supports YAML anchors for reusable configurations and ${{ env.VAR }} / ${{ secrets.VAR }} for variable interpolation.",
  "properties": {
    "name": {
      "default": "Crystalith",
