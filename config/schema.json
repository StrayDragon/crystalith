    },
    "embedding": {
      "$ref": "#/$defs/EmbeddingSettings"
    },
    "ai": {
      "$ref": "#/$defs/AISettings"
    },
    "chat": {
      "$ref": "#/$defs/ChatSettings"
    },
    "refine": {
      "$ref": "#/$defs/RefineSettings"
    },
    "context_window": {
      "$ref": "#/$defs/ContextWindowSettings"
    },
    "search": {
      "$ref": "#/$defs/SearchSettings",
      "description": "Web search settings"
    },
    "source_ingestion": {
