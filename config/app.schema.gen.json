{
  "$defs": {
    "AISettings": {
      "description": "AI provider runtime settings.",
      "properties": {
        "timeout": {
          "default": 60,
          "description": "Provider request timeout in seconds",
          "maximum": 600,
          "minimum": 1,
          "title": "Timeout",
          "type": "integer"
        },
        "max_retries": {
          "default": 3,
          "description": "Maximum retries for retryable provider errors",
          "maximum": 10,
          "minimum": 0,
          "title": "Max Retries",
          "type": "integer"
        }
      },
      "title": "AISettings",
      "type": "object"
    },
    "AppAuthSettings": {
      "description": "Optional API authentication settings for self-host deployments.",
      "properties": {
        "enabled": {
          "default": false,
          "description": "If true, require API key authentication for /v1 endpoints.",
          "title": "Enabled",
          "type": "boolean"
        },
        "api_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Shared API key used for 'Authorization: Bearer <token>'. Prefer injecting via {{ env.* }} / {{ secret.* }}.",
          "title": "Api Key"
        }
      },
      "title": "AppAuthSettings",
      "type": "object"
    },
    "AppFeaturesSettings": {
      "description": "Application feature flags.",
      "properties": {
        "chat_prompt_presets_enabled": {
          "default": false,
          "description": "Enable /prompt:* directives in QA.",
          "title": "Chat Prompt Presets Enabled",
          "type": "boolean"
        },
        "workspace_frontend_bundles_enabled": {
          "default": true,
          "description": "If true, expose frontend bundle descriptors for workspace tools/outputs (enables interactive renderers in the web UI). Set false to force fallback rendering.",
          "title": "Workspace Frontend Bundles Enabled",
          "type": "boolean"
        }
      },
      "title": "AppFeaturesSettings",
      "type": "object"
    },
    "AppSettings": {
      "description": "Application settings.",
      "properties": {
        "name": {
          "default": "Crystalith",
          "title": "Name",
          "type": "string"
        },
        "openapi_path": {
          "default": "/v1/codev/openapi.json",
          "title": "Openapi Path",
          "type": "string"
        },
        "openapi_ui_path": {
          "default": "/v1/codev/openapi-ui/scalar",
          "title": "Openapi Ui Path",
          "type": "string"
        },
        "features": {
          "$ref": "#/$defs/AppFeaturesSettings",
          "description": "Feature flags."
        },
        "auth": {
          "$ref": "#/$defs/AppAuthSettings",
          "description": "Optional API authentication settings."
        },
        "cors": {
          "$ref": "#/$defs/CorsSettings",
          "description": "CORS settings"
        },
        "startup": {
          "$ref": "#/$defs/StartupSettings",
          "description": "Startup behaviors"
        },
        "http_guardrails": {
          "$ref": "#/$defs/HttpGuardrailsSettings",
          "description": "HTTP runtime guardrails (auto for non-local exposure)."
        }
      },
      "title": "AppSettings",
      "type": "object"
    },
    "BrowserlessSettings": {
      "description": "Browserless 浏览器渲染提取器配置。",
      "properties": {
        "enabled": {
          "default": false,
          "description": "是否启用 Browserless 提取器",
          "title": "Enabled",
          "type": "boolean"
        },
        "endpoint": {
          "default": "ws://localhost:3000",
          "description": "Browserless WebSocket 端点",
          "title": "Endpoint",
          "type": "string"
        },
        "token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "认证令牌（可选）",
          "title": "Token"
        },
        "timeout": {
          "default": 60,
          "description": "页面加载超时时间（秒）",
          "maximum": 300,
          "minimum": 10,
          "title": "Timeout",
          "type": "integer"
        },
        "wait_until": {
          "default": "networkidle",
          "description": "页面等待条件",
          "enum": [
            "load",
            "domcontentloaded",
            "networkidle"
          ],
          "title": "Wait Until",
          "type": "string"
        }
      },
      "title": "BrowserlessSettings",
      "type": "object"
    },
    "CacheSettings": {
      "description": "Cache settings.",
      "properties": {
        "provider": {
          "default": "memory",
          "enum": [
            "memory",
            "redis",
            "auto"
          ],
          "title": "Provider",
          "type": "string"
        },
        "ttl": {
          "default": 60,
          "description": "Default cache TTL in seconds (0 disables TTL)",
          "title": "Ttl",
          "type": "integer"
        },
        "max_size": {
          "default": 2048,
          "description": "Maximum number of cached keys for in-memory cache",
          "title": "Max Size",
          "type": "integer"
        },
        "redis_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Redis connection URL when provider=redis",
          "title": "Redis Url"
        },
        "redis_url_candidates": {
          "description": "Optional candidate Redis URLs. When provider=auto, the loader may probe and select the first reachable Redis and upgrade cache.provider to redis. When none are reachable, it falls back to memory.",
          "items": {
            "type": "string"
          },
          "title": "Redis Url Candidates",
          "type": "array"
        }
      },
      "title": "CacheSettings",
      "type": "object"
    },
    "ChatSettings": {
      "description": "Chat settings.\n\nUse models.defaults.chat to specify the default chat model.\nThis section only contains chat-specific options.",
      "properties": {},
      "title": "ChatSettings",
      "type": "object"
    },
    "CompletionOptions": {
      "description": "Default completion options for model inference.\n\nSimilar to Continue's defaultCompletionOptions.",
      "properties": {
        "context_length": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Maximum context length (tokens)",
          "title": "Context Length"
        },
        "max_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Maximum tokens to generate",
          "title": "Max Tokens"
        },
        "temperature": {
          "anyOf": [
            {
              "maximum": 2.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Sampling temperature",
          "title": "Temperature"
        },
        "top_p": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Nucleus sampling probability",
          "title": "Top P"
        },
        "top_k": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Top-k sampling",
          "title": "Top K"
        },
        "stop": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Stop sequences",
          "title": "Stop"
        },
        "reasoning": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Enable reasoning/thinking mode",
          "title": "Reasoning"
        }
      },
      "title": "CompletionOptions",
      "type": "object"
    },
    "ConcurrencySettings": {
      "description": "Stage-level concurrency guardrails for key I/O phases.",
      "properties": {
        "embedding": {
          "default": 8,
          "description": "Max concurrent embedding calls (0 disables limiter). Applies to retrieval/QA/refine embedding stages.",
          "minimum": 0,
          "title": "Embedding",
          "type": "integer"
        },
        "vector_search": {
          "default": 8,
          "description": "Max concurrent vector search calls (0 disables limiter).",
          "minimum": 0,
          "title": "Vector Search",
          "type": "integer"
        },
        "llm_generate": {
          "default": 4,
          "description": "Max concurrent LLM generation calls (0 disables limiter).",
          "minimum": 0,
          "title": "Llm Generate",
          "type": "integer"
        }
      },
      "title": "ConcurrencySettings",
      "type": "object"
    },
    "ContextWindowSettings": {
      "description": "Context window management settings.",
      "properties": {
        "max_tokens": {
          "default": 8000,
          "minimum": 1,
          "title": "Max Tokens",
          "type": "integer"
        },
        "compression_strategy": {
          "default": "truncate",
          "enum": [
            "truncate",
            "summarize"
          ],
          "title": "Compression Strategy",
          "type": "string"
        },
        "window_size": {
          "default": 10,
          "minimum": 0,
          "title": "Window Size",
          "type": "integer"
        },
        "priority": {
          "items": {
            "enum": [
              "history",
              "retrieval",
              "recent",
              "system"
            ],
            "type": "string"
          },
          "title": "Priority",
          "type": "array"
        }
      },
      "title": "ContextWindowSettings",
      "type": "object"
    },
    "CorsSettings": {
      "description": "CORS middleware settings for the API server.",
      "properties": {
        "allow_origins": {
          "description": "Allowed origins (empty list disables CORS middleware).",
          "items": {
            "type": "string"
          },
          "title": "Allow Origins",
          "type": "array"
        },
        "allow_credentials": {
          "default": true,
          "description": "Whether to allow cookies/credentials.",
          "title": "Allow Credentials",
          "type": "boolean"
        },
        "allow_methods": {
          "description": "Allowed methods.",
          "items": {
            "type": "string"
          },
          "title": "Allow Methods",
          "type": "array"
        },
        "allow_headers": {
          "description": "Allowed headers.",
          "items": {
            "type": "string"
          },
          "title": "Allow Headers",
          "type": "array"
        }
      },
      "title": "CorsSettings",
      "type": "object"
    },
    "DatabaseSettings": {
      "description": "Database settings.",
      "properties": {
        "url": {
          "default": "sqlite+aiosqlite:///./data/app.db",
          "title": "Url",
          "type": "string"
        },
        "url_candidates": {
          "description": "Optional candidate database URLs. When set, the loader may probe and select the first reachable URL for the active runtime environment (e.g. compose service name vs host dev ports).",
          "items": {
            "type": "string"
          },
          "title": "Url Candidates",
          "type": "array"
        }
      },
      "title": "DatabaseSettings",
      "type": "object"
    },
    "EmbeddingSettings": {
      "description": "Embedding settings.\n\nUse models.defaults.embedding to specify the default embedding model.\nThis section only contains embedding-specific options.",
      "properties": {
        "chunk_size": {
          "default": 512,
          "description": "Default chunk size for embedding",
          "minimum": 64,
          "title": "Chunk Size",
          "type": "integer"
        },
        "batch_size": {
          "default": 32,
          "description": "Batch size for embedding requests",
          "minimum": 1,
          "title": "Batch Size",
          "type": "integer"
        }
      },
      "title": "EmbeddingSettings",
      "type": "object"
    },
    "FirecrawlSettings": {
      "description": "Firecrawl API 提取器配置。",
      "properties": {
        "enabled": {
          "default": false,
          "description": "是否启用 Firecrawl 提取器",
          "title": "Enabled",
          "type": "boolean"
        },
        "api_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Firecrawl API 密钥",
          "title": "Api Key"
        },
        "timeout": {
          "default": 60,
          "description": "请求超时时间（秒）",
          "maximum": 300,
          "minimum": 10,
          "title": "Timeout",
          "type": "integer"
        }
      },
      "title": "FirecrawlSettings",
      "type": "object"
    },
    "HttpGuardrailsSettings": {
      "description": "HTTP runtime guardrails for non-local exposure.",
      "properties": {
        "mode": {
          "default": "auto",
          "description": "Guardrails mode: auto enables only when the server is bound to a non-loopback host; enabled/disabled force override.",
          "enum": [
            "auto",
            "enabled",
            "disabled"
          ],
          "title": "Mode",
          "type": "string"
        },
        "upload_max_bytes": {
          "default": 52428800,
          "description": "Maximum upload size in bytes when guardrails are enabled (0 disables).",
          "minimum": 0,
          "title": "Upload Max Bytes",
          "type": "integer"
        },
        "rate_limit": {
          "$ref": "#/$defs/HttpRateLimitSettings",
          "description": "HTTP rate limiting settings."
        }
      },
      "title": "HttpGuardrailsSettings",
      "type": "object"
    },
    "HttpProxySettings": {
      "description": "HTTP 代理配置。\n\n支持 HTTP/HTTPS/SOCKS5 代理协议，可作为 YAML anchor 被其他功能引用。\n\nExample:\n    proxy_settings: &default_proxy\n      enabled: false\n      http_url: \"http://127.0.0.1:7890\"\n      https_url: \"http://127.0.0.1:7890\"\n      socks5_url: null\n      no_proxy: [\"localhost\", \"127.0.0.1\"]\n\n    source_ingestion:\n      url_fetch:\n        proxy: *default_proxy",
      "properties": {
        "enabled": {
          "default": false,
          "description": "是否启用代理",
          "title": "Enabled",
          "type": "boolean"
        },
        "http_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "HTTP 代理 URL (例如 http://127.0.0.1:7890)",
          "title": "Http Url"
        },
        "https_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "HTTPS 代理 URL (可选，默认使用 http_url)",
          "title": "Https Url"
        },
        "socks5_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "SOCKS5 代理 URL (例如 socks5://127.0.0.1:1080)",
          "title": "Socks5 Url"
        },
        "no_proxy": {
          "description": "不走代理的域名/IP列表",
          "items": {
            "type": "string"
          },
          "title": "No Proxy",
          "type": "array"
        }
      },
      "title": "HttpProxySettings",
      "type": "object"
    },
    "HttpRateLimitSettings": {
      "description": "HTTP rate limiting settings (best-effort, single-process baseline).",
      "properties": {
        "enabled": {
          "default": true,
          "description": "If true, enable basic HTTP rate limiting for core /v1 endpoints.",
          "title": "Enabled",
          "type": "boolean"
        },
        "window_s": {
          "default": 60,
          "description": "Fixed window size in seconds.",
          "minimum": 1,
          "title": "Window S",
          "type": "integer"
        },
        "max_requests": {
          "default": 600,
          "description": "Maximum requests per window per key (0 disables).",
          "minimum": 0,
          "title": "Max Requests",
          "type": "integer"
        },
        "key": {
          "const": "ip",
          "default": "ip",
          "description": "Rate limit identity strategy (default: direct client IP; do not trust proxy headers).",
          "title": "Key",
          "type": "string"
        }
      },
      "title": "HttpRateLimitSettings",
      "type": "object"
    },
    "JinaSettings": {
      "description": "Jina Reader API 提取器配置。",
      "properties": {
        "enabled": {
          "default": true,
          "description": "是否启用 Jina Reader 提取器",
          "title": "Enabled",
          "type": "boolean"
        },
        "api_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Jina API 密钥（可选，用于更高配额）",
          "title": "Api Key"
        },
        "timeout": {
          "default": 30,
          "description": "请求超时时间（秒）",
          "maximum": 120,
          "minimum": 5,
          "title": "Timeout",
          "type": "integer"
        },
        "proxy": {
          "anyOf": [
            {
              "$ref": "#/$defs/HttpProxySettings"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "代理配置（可选）"
        }
      },
      "title": "JinaSettings",
      "type": "object"
    },
    "JsonPrimitive": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "JsonValue": {
      "anyOf": [
        {
          "$ref": "#/$defs/JsonPrimitive"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        }
      ]
    },
    "ModelConfig": {
      "description": "Configuration for a single AI model.\n\nInspired by Continue's model configuration with enhancements for Crystalith.\n\nExample:\n    - id: \"gpt-5.2\"\n      provider: \"openai\"\n      model: \"gpt-5.2\"\n      display_name: \"GPT-5.2\"\n      description: \"Latest OpenAI model\"\n      roles: [chat, edit]\n      capabilities: [tool_use, image_input]\n      provider_config:\n        <<: *openai_main\n      completion_options:\n        temperature: 0.7\n        max_tokens: 4096",
      "properties": {
        "id": {
          "description": "Unique identifier for the model",
          "title": "Id",
          "type": "string"
        },
        "provider": {
          "description": "Provider id (built-in: openai, or a plugin provider id)",
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "description": "Model name/identifier used by the provider",
          "title": "Model",
          "type": "string"
        },
        "display_name": {
          "description": "Human-readable display name",
          "title": "Display Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "description": "Optional description",
          "title": "Description",
          "type": "string"
        },
        "roles": {
          "description": "Roles this model can fulfill: chat, embed, edit, apply, autocomplete, summarize",
          "items": {
            "enum": [
              "chat",
              "embed",
              "edit",
              "apply",
              "autocomplete",
              "summarize"
            ],
            "type": "string"
          },
          "title": "Roles",
          "type": "array"
        },
        "capabilities": {
          "description": "Special capabilities: tool_use, image_input, audio_input, streaming",
          "items": {
            "enum": [
              "tool_use",
              "image_input",
              "audio_input",
              "streaming"
            ],
            "type": "string"
          },
          "title": "Capabilities",
          "type": "array"
        },
        "provider_config": {
          "anyOf": [
            {
              "$ref": "#/$defs/OpenAIProviderSettings"
            },
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Provider-specific configuration (can reference providers via anchors)",
          "title": "Provider Config"
        },
        "completion_options": {
          "anyOf": [
            {
              "$ref": "#/$defs/CompletionOptions"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Default completion options for this model"
        },
        "request_options": {
          "anyOf": [
            {
              "$ref": "#/$defs/RequestOptions"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "HTTP request options"
        }
      },
      "required": [
        "id",
        "provider",
        "model",
        "display_name"
      ],
      "title": "ModelConfig",
      "type": "object"
    },
    "ModelDefaults": {
      "description": "Default model selections.",
      "properties": {
        "chat": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Default model ID for chat/generation",
          "title": "Chat"
        },
        "embedding": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Default model ID for embeddings",
          "title": "Embedding"
        },
        "edit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Default model ID for code editing",
          "title": "Edit"
        },
        "autocomplete": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Default model ID for autocomplete",
          "title": "Autocomplete"
        }
      },
      "title": "ModelDefaults",
      "type": "object"
    },
    "ModelsSettings": {
      "description": "Multi-model configuration settings.\n\nAll models must be defined in `available` list with unique IDs.\nUse `defaults` to specify which model to use for each role.\n\nExample:\n    models:\n      defaults:\n        chat: \"gpt-5.2\"\n        embedding: \"bge-m3-local\"\n      available:\n        - id: \"gpt-5.2\"\n          provider: \"openai\"\n          model: \"gpt-5.2\"\n          roles: [chat, edit]",
      "properties": {
        "defaults": {
          "$ref": "#/$defs/ModelDefaults"
        },
        "available": {
          "items": {
            "$ref": "#/$defs/ModelConfig"
          },
          "title": "Available",
          "type": "array"
        }
      },
      "title": "ModelsSettings",
      "type": "object"
    },
    "OpenAIProviderSettings": {
      "description": "OpenAI-compatible provider settings.",
      "properties": {
        "api_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Api Key"
        },
        "base_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base Url"
        },
