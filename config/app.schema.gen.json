            "type": "string"
          },
          "title": "Allowlist Cidrs",
          "type": "array"
        },
        "allowlist_only": {
          "default": false,
          "description": "仅允许 allowlist 命中的 URL（默认 false：允许公网，但拒绝 localhost/私网/元数据等高风险目标）。",
          "title": "Allowlist Only",
          "type": "boolean"
        },
        "max_redirects": {
          "default": 5,
          "description": "URL fetch 最大重定向跳数（逐跳重验 SSRF 安全策略）。",
          "maximum": 10,
          "minimum": 0,
