{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "./app.schema.gen.json",
  "title": "Crystalith v2 Configuration Schema",
  "description": "Auto-generated JSON Schema for config/app.yaml. DO NOT EDIT MANUALLY — update Zod schemas in apps/server/src/shared/config.ts and run `just gen-app-schema`.",
  "type": "object",
  "properties": {
    "app": {
      "description": "应用层设置：CORS、auth、startup behavior、feature flags",
      "type": "object",
      "properties": {
        "features": {
          "type": "object",
          "properties": {
            "workspace_frontend_bundles_enabled": {
              "description": "app.features.workspace_frontend_bundles_enabled",
              "default": true,
              "type": "boolean"
            }
          }
        },
        "auth": {
          "type": "object",
          "properties": {
            "enabled": {
              "description": "app.auth.enabled",
              "default": false,
              "type": "boolean"
            }
          }
        },
        "cors": {
          "type": "object",
          "properties": {
            "allow_origins": {
              "description": "app.cors.allow_origins",
              "default": [
                "http://localhost:3000"
              ],
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "startup": {
          "type": "object",
          "properties": {
            "auto_db_init": {
              "description": "app.startup.auto_db_init",
              "default": true,
              "type": "boolean"
            },
            "cleanup_failed_sources": {
              "description": "app.startup.cleanup_failed_sources",
              "default": false,
              "type": "boolean"
            }
          }
        },
        "http_guardrails": {
          "type": "object",
          "properties": {
            "upload_max_bytes": {
              "description": "上传文件大小上限（字节）",
              "default": 52428800,
              "type": "number"
            }
          }
        }
      }
    },
    "ai": {
      "description": "AI 运行时设置：超时、重试次数",
      "type": "object",
      "properties": {
        "timeout": {
          "description": "AI 调用超时（秒），范围 1-600",
          "default": 60,
          "type": "number"
        },
        "max_retries": {
          "description": "AI 调用失败最大重试次数，范围 0-10",
          "default": 3,
          "type": "number"
        }
      }
    },
    "completion_options": {
      "description": "Completion 参数默认值：temperature、top_p、stop 序列等",
      "type": "object",
      "properties": {
        "temperature": {
          "description": "生成温度，值越高输出越随机，范围 0-2",
          "type": "number"
        },
        "top_p": {
          "description": "核采样概率阈值，范围 0-1",
          "type": "number"
        },
        "top_k": {
          "description": "Top-K 采样参数，限制每次选择的前 K 个 token",
          "type": "number"
        },
        "stop": {
          "description": "停止序列列表，遇到任一序列即停止生成",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reasoning": {
          "description": "推理预算 token 数，0 表示不使用推理模式",
          "type": "number"
        }
      }
    },
    "concurrency": {
      "description": "并发控制门禁：embedding、vector_search、llm_generate 的并发数限制",
      "type": "object",
      "properties": {
        "embedding": {
          "description": "嵌入生成最大并发数，0 表示不限制",
          "default": 8,
          "type": "number"
        },
        "vector_search": {
          "description": "向量搜索最大并发数，0 表示不限制",
          "default": 8,
          "type": "number"
        },
        "llm_generate": {
          "description": "LLM 生成最大并发数（含流式调用），0 表示不限制",
          "default": 4,
          "type": "number"
        }
      }
    },
    "embedding": {
      "description": "文本嵌入设置：chunk_size、batch_size",
      "type": "object",
      "properties": {
        "chunk_size": {
          "description": "文本分块大小（token 数），最小 64",
          "default": 512,
          "type": "number"
        },
        "batch_size": {
          "description": "嵌入 API 批处理大小，最小 1",
          "default": 32,
          "type": "number"
        }
      }
    },
    "context_window": {
      "description": "上下文窗口设置：max_tokens、compression_strategy、window_size",
      "type": "object",
      "properties": {
        "max_tokens": {
          "description": "上下文窗口最大 token 数",
          "default": 8000,
          "type": "number"
        },
        "compression_strategy": {
          "description": "上下文超限时压缩策略：truncate 截断 / summarize 摘要",
          "default": "truncate",
          "type": "string",
          "enum": [
            "truncate",
            "summarize"
          ]
        },
        "window_size": {
          "description": "上下文窗口包含的历史消息轮次数",
          "default": 10,
          "type": "number"
        },
        "priority": {
          "description": "context_window.priority",
          "default": [
            "history",
            "retrieval",
            "recent",
            "system"
          ],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "search": {
      "description": "搜索引擎设置：SearXNG 实例地址、超时、最大结果数",
      "type": "object",
      "properties": {
        "searxng": {
          "default": {
            "host": "",
            "api_key": null,
            "max_results": 10,
            "timeout": 20000
          },
          "type": "object",
          "properties": {
            "host": {
              "description": "SearXNG 实例 URL，留空禁用搜索引擎",
              "default": "",
              "type": "string"
            },
            "api_key": {
              "description": "SearXNG API 密钥，可为空",
              "default": null,
              "type": "string"
            },
            "max_results": {
              "description": "搜索结果最大条数，范围 1-50",
              "default": 10,
              "type": "number"
            },
            "timeout": {
              "description": "SearXNG 请求超时（毫秒），最大 300000（5 分钟）",
              "default": 20000,
              "type": "number"
            }
          }
        }
      }
    },
    "optional_services": {
      "description": "可选服务段落（Redis 等）。SearXNG 诊断与网搜统一走 search.searxng.host / CL_SEARXNG_HOST，本段 searxng 字段已忽略。",
      "type": "object",
      "properties": {
        "searxng": {
          "type": "object",
          "properties": {
            "enabled": {
              "description": "是否启用该服务",
              "default": false,
              "type": "boolean"
            },
            "endpoint": {
              "description": "服务端点地址",
              "type": "string"
            },
            "timeout_s": {
              "description": "请求超时（秒）",
              "type": "number"
            }
          }
        },
        "cache_redis": {
          "type": "object",
          "properties": {
            "enabled": {
              "description": "是否启用该服务",
              "default": false,
              "type": "boolean"
            },
            "endpoint": {
              "description": "服务端点地址",
              "type": "string"
            },
            "timeout_s": {
              "description": "请求超时（秒）",
              "type": "number"
            }
          }
        }
      }
    },
    "storage": {
      "description": "存储设置：数据根目录路径",
      "type": "object",
      "properties": {
        "data_root": {
          "description": "运行时数据根目录路径，相对路径从 CWD 解析",
          "default": "./data",
          "type": "string"
        }
      }
    },
    "source_ingestion": {
      "description": "root.source_ingestion",
      "type": "object",
      "properties": {
        "url_fetch": {
          "description": "source_ingestion.url_fetch",
          "type": "object",
          "properties": {
            "proxy": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "http_url": {
                  "type": "string"
                },
                "https_url": {
                  "type": "string"
                },
                "socks5_url": {
                  "type": "string"
                },
                "no_proxy": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "timeout": {
              "description": "source_ingestion.url_fetch.timeout",
              "type": "number"
            },
            "retry_count": {
              "description": "source_ingestion.url_fetch.retry_count",
              "type": "number"
            },
            "retry_delay": {
              "description": "source_ingestion.url_fetch.retry_delay",
              "type": "number"
            },
            "security": {
              "description": "source_ingestion.url_fetch.security",
              "type": "object",
              "properties": {
                "allowlist_only": {
                  "description": "仅允许白名单中的主机访问，禁止所有未列出的地址",
                  "type": "boolean"
                },
                "allowlist_hosts": {
                  "description": "白名单主机名列表（精确匹配）",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "allowlist_domains": {
                  "description": "白名单域名列表（子域名通配）",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "allowlist_cidrs": {
                  "description": "白名单 CIDR 网段列表",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "max_redirects": {
                  "description": "URL 获取时最大重定向次数",
                  "type": "number"
                }
              }
            }
          }
        },
        "web_extraction": {
          "description": "source_ingestion.web_extraction",
          "type": "object",
          "properties": {
            "fallback_order": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "enable_fallback": {
              "type": "boolean"
            },
            "trafilatura": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "include_tables": {
                  "type": "boolean"
                },
                "include_links": {
                  "type": "boolean"
                },
                "output_format": {
                  "type": "string"
                },
                "timeout": {
                  "type": "number"
                },
                "proxy": {
                  "type": "object",
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    },
                    "http_url": {
                      "type": "string"
                    },
                    "https_url": {
                      "type": "string"
                    },
                    "socks5_url": {
                      "type": "string"
                    },
                    "no_proxy": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            },
            "jina": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "api_key": {
                  "type": "string"
                },
                "timeout": {
                  "type": "number"
                },
                "proxy": {
                  "type": "object",
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    },
                    "http_url": {
                      "type": "string"
                    },
                    "https_url": {
                      "type": "string"
                    },
                    "socks5_url": {
                      "type": "string"
                    },
                    "no_proxy": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            },
            "firecrawl": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "api_key": {
                  "type": "string"
                },
                "timeout": {
                  "type": "number"
                }
              }
            },
            "browserless": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "endpoint": {
                  "type": "string"
                },
                "token": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "models": {
      "description": "模型配置：默认模型、可用模型列表、提供商配置",
      "type": "object",
      "properties": {
        "defaults": {
          "default": {},
          "type": "object",
          "properties": {
            "chat": {
              "type": "string"
            },
            "embedding": {
              "type": "string"
            },
            "edit": {
              "type": "string"
            },
            "autocomplete": {
              "type": "string"
            }
          }
        },
        "available": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "provider": {
                "type": "string"
              },
              "model": {
                "type": "string"
              },
              "displayName": {
                "type": "string"
              },
              "description": {
                "default": "",
                "type": "string"
              },
              "roles": {
                "default": [
                  "chat"
                ],
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "chat",
                    "embed",
                    "edit",
                    "apply",
                    "autocomplete",
                    "summarize"
                  ]
                }
              },
              "capabilities": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "tool_use",
                    "image_input",
                    "audio_input",
                    "streaming"
                  ]
                }
              },
              "providerConfig": {
                "type": "object",
                "properties": {
                  "apiKey": {
                    "type": "string"
                  },
                  "baseUrl": {
                    "type": "string"
                  },
                  "organization": {
                    "type": "string"
                  },
                  "project": {
                    "type": "string"
                  }
                }
              },
              "completionOptions": {
                "type": "object",
                "properties": {
                  "contextLength": {
                    "type": "number"
                  },
                  "maxTokens": {
                    "type": "number"
                  },
                  "temperature": {
                    "type": "number"
                  },
                  "topP": {
                    "type": "number"
                  },
                  "topK": {
                    "type": "number"
                  },
                  "stop": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "reasoning": {
                    "type": "boolean"
                  }
                }
              },
              "requestOptions": {
                "type": "object",
                "properties": {
                  "timeout": {
                    "type": "number"
                  },
                  "verifySsl": {
                    "default": true,
                    "type": "boolean"
                  },
                  "proxy": {
                    "type": "string"
                  },
                  "headers": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                }
              },
              "sdk": {
                "type": "string"
              },
              "factory": {
                "type": "string"
              },
              "providerOptions": {
                "type": "object",
                "additionalProperties": {}
              }
            }
          }
        }
      }
    },
    "providers": {
      "description": "AI 提供商配置：name → API key、base URL",
      "default": {},
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "apiKey": {
            "type": "string"
          },
          "baseUrl": {
            "type": "string"
          },
          "organization": {
            "type": "string"
          },
          "project": {
            "type": "string"
          }
        }
      }
    },
    "cache": {
      "description": "缓存设置：provider、TTL、最大条目数",
      "type": "object",
      "properties": {
        "provider": {
          "description": "缓存提供者：memory 内存 / auto 自动选择",
          "default": "memory",
          "type": "string",
          "enum": [
            "memory",
            "auto"
          ]
        },
        "ttl": {
          "description": "缓存 TTL（秒）",
          "default": 60,
          "type": "number"
        },
        "max_size": {
          "description": "缓存最大条目数",
          "default": 2048,
          "type": "number"
        }
      }
    },
    "database": {
      "description": "数据库设置（v1 兼容）",
      "type": "object",
      "properties": {
        "url": {
          "description": "数据库连接 URL（v1 兼容）",
          "default": "sqlite+aiosqlite:///./data/app.db",
          "type": "string"
        },
        "url_candidates": {
          "description": "备用数据库 URL 列表",
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "plugins": {
      "description": "插件发现与加载配置",
      "type": "object",
      "properties": {
        "enabled": {
          "description": "启用的插件 ID 列表（白名单）",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "disabled": {
          "description": "禁用的插件 ID 列表（黑名单，优先）",
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "load_order": {
          "description": "插件加载顺序（后加载优先）",
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "proxy_settings": {
      "description": "出站代理设置",
      "type": "object",
      "properties": {
        "enabled": {
          "description": "是否启用代理",
          "type": "boolean"
        },
        "http_url": {
          "description": "HTTP 代理 URL",
          "default": null,
          "type": "string"
        },
        "https_url": {
          "description": "HTTPS 代理 URL",
          "default": null,
          "type": "string"
        },
        "socks5_url": {
          "description": "SOCKS5 代理 URL",
          "default": null,
          "type": "string"
        },
        "no_proxy": {
          "description": "不走代理的地址列表",
          "default": [
            "localhost",
            "127.0.0.1"
          ],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "research": {
      "description": "Deep Research 运行时：进度账本保留、支路并行度、可选拆解模型（默认继承 chat）等",
      "default": {
        "progressEventRetain": 200,
        "parallelBranchUnits": 2
      },
      "type": "object",
      "properties": {
        "progressEventRetain": {
          "description": "终态后进度账本保留最近 N 条",
          "default": 200,
          "type": "number"
        },
        "parallelBranchUnits": {
          "description": "同一 Run 同时推进的支路 work-unit 上限（1=串行，默认 2，最大 8）",
          "default": 2,
          "type": "number"
        },
        "decomposeModelId": {
          "description": "主题自动拆解所用模型 id；省略或空字符串时继承 models.defaults.chat",
          "type": "string"
        }
      }
    }
  },
  "additionalProperties": true
}
