    "UrlFetchSecuritySettings": {
      "description": "URL fetch SSRF 安全策略配置。",
      "properties": {
        "allowlist_hosts": {
          "description": "显式允许的 host（精确匹配）。可用于受控环境下放行内部站点。",
          "items": {
            "type": "string"
