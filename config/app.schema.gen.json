          "title": "Allowlist Hosts",
          "type": "array"
        },
        "allowlist_domains": {
          "description": "显式允许的域名后缀（example.com 将匹配 example.com 和 *.example.com）。",
          "items": {
            "type": "string"
          },
          "title": "Allowlist Domains",
          "type": "array"
        },
        "allowlist_cidrs": {
          "description": "显式允许的 CIDR 网段（例如 10.0.0.0/8）。",
