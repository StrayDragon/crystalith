    "WebExtractionSettings": {
      "description": "网页内容提取配置。\n\n支持多种提取策略，按优先级自动降级：\n1. trafilatura - 本地提取，速度快，无需外部服务\n2. jina - Jina Reader API，免费且支持 JS 渲染\n3. firecrawl - 外部 API，功能强大，需要 API 密钥\n4. browserless - 浏览器渲染，适合复杂动态页面，需要服务\n\nExample:\n    web_extraction:\n      fallback_order: [\"trafilatura\", \"jina\", \"firecrawl\", \"browserless\"]\n      trafilatura:\n        enabled: true\n        output_format: \"markdown\"\n      jina:\n        enabled: true\n      firecrawl:\n        enabled: false\n        api_key: \"fc-xxx\"\n      browserless:\n        enabled: false\n        endpoint: \"ws://localhost:3000\"",
      "properties": {
        "fallback_order": {
          "description": "提取器降级顺序（按优先级排列）",
          "items": {
            "type": "string"
          },
          "title": "Fallback Order",
          "type": "array"
        },
        "enable_fallback": {
          "default": true,
          "description": "是否启用自动降级",
          "title": "Enable Fallback",
          "type": "boolean"
        },
        "trafilatura": {
          "$ref": "#/$defs/TrafilaturaSettings",
          "description": "Trafilatura 本地提取器配置"
        },
        "jina": {
          "$ref": "#/$defs/JinaSettings",
          "description": "Jina Reader API 提取器配置"
        },
        "firecrawl": {
          "$ref": "#/$defs/FirecrawlSettings",
          "description": "Firecrawl API 提取器配置"
        },
        "browserless": {
          "$ref": "#/$defs/BrowserlessSettings",
          "description": "Browserless 浏览器渲染提取器配置"
        }
      },
      "title": "WebExtractionSettings",
      "type": "object"
    }
