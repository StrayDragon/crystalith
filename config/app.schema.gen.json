{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "./app.schema.gen.json",
  "title": "Crystalith v2 Configuration Schema",
  "description": "Auto-generated JSON Schema for config/app.yaml. DO NOT EDIT MANUALLY — update Zod schemas in apps/server/src/shared/config.ts and run `just gen-app-schema`.",
  "type": "object",
  "properties": {
    "app": {
      "description": "应用层设置：CORS、auth、startup behavior、feature flags",
      "type": "object",
      "properties": {
        "http_guardrails": {
          "type": "object",
          "properties": {
            "upload_max_bytes": {
              "description": "上传文件大小上限（字节）",
              "default": 52428800,
              "type": "number"
            }
          }
        }
      }
    },
    "ai": {
      "description": "AI 运行时设置：超时、重试次数",
      "type": "object",
      "properties": {
        "timeout": {
          "description": "AI 调用超时（秒），范围 1-600",
          "default": 60,
          "type": "number"
        },
        "max_retries": {
          "description": "AI 调用失败最大重试次数，范围 0-10",
          "default": 3,
          "type": "number"
        }
      }
    },
    "completion_options": {
      "description": "Completion 参数默认值：temperature、top_p、stop 序列等",
      "type": "object",
      "properties": {
        "temperature": {
          "description": "生成温度，值越高输出越随机，范围 0-2",
          "type": "number"
        },
        "top_p": {
          "description": "核采样概率阈值，范围 0-1",
          "type": "number"
        },
        "top_k": {
          "description": "Top-K 采样参数，限制每次选择的前 K 个 token",
          "type": "number"
        },
        "stop": {
          "description": "停止序列列表，遇到任一序列即停止生成",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reasoning": {
          "description": "推理预算 token 数，0 表示不使用推理模式",
          "type": "number"
        }
      }
    },
    "concurrency": {
      "description": "并发控制门禁：embedding、vector_search、llm_generate 的并发数限制",
      "type": "object",
      "properties": {
        "embedding": {
          "description": "嵌入生成最大并发数，0 表示不限制",
          "default": 8,
          "type": "number"
        },
        "vector_search": {
          "description": "向量搜索最大并发数，0 表示不限制",
          "default": 8,
          "type": "number"
        },
        "llm_generate": {
          "description": "LLM 生成最大并发数（含流式调用），0 表示不限制",
          "default": 4,
          "type": "number"
        }
      }
    },
    "embedding": {
      "description": "文本嵌入设置：chunk_size、batch_size",
      "type": "object",
      "properties": {
        "chunk_size": {
          "description": "文本分块大小（token 数），最小 64",
          "default": 512,
          "type": "number"
        },
        "batch_size": {
          "description": "嵌入 API 批处理大小，最小 1",
          "default": 32,
          "type": "number"
        }
      }
    },
    "context_window": {
      "description": "上下文窗口设置：max_tokens、compression_strategy、window_size",
      "type": "object",
      "properties": {
        "max_tokens": {
          "description": "上下文窗口最大 token 数",
          "default": 8000,
          "type": "number"
        },
        "compression_strategy": {
          "description": "上下文超限时压缩策略：truncate 截断 / summarize 摘要",
          "default": "truncate",
          "type": "string",
          "enum": [
            "truncate",
            "summarize"
          ]
        },
        "window_size": {
          "description": "上下文窗口包含的历史消息轮次数",
          "default": 10,
          "type": "number"
        }
      }
    },
    "search": {
      "description": "搜索引擎设置：SearXNG 实例地址、超时、最大结果数",
      "type": "object",
      "properties": {
        "searxng": {
          "default": {
            "host": "",
            "api_key": null,
            "max_results": 10,
            "timeout": 20000
          },
          "type": "object",
          "properties": {
            "host": {
              "description": "SearXNG 实例 URL，留空禁用搜索引擎",
              "default": "",
              "type": "string"
            },
            "api_key": {
              "description": "SearXNG API 密钥，可为空",
              "default": null,
              "type": "string"
            },
            "max_results": {
              "description": "搜索结果最大条数，范围 1-50",
              "default": 10,
              "type": "number"
            },
            "timeout": {
              "description": "SearXNG 请求超时（毫秒），最大 120000",
              "default": 20000,
              "type": "number"
            }
          }
        }
      }
    },
    "optional_services": {
      "description": "可选服务配置：Chroma、SearXNG、Redis 的启用状态与接入点",
      "type": "object",
      "properties": {
        "chroma": {
          "default": {
            "enabled": false,
            "endpoint": "http://localhost:8000",
            "timeout_s": 3
          },
          "type": "object",
          "properties": {
            "enabled": {
              "description": "是否启用该服务",
              "default": false,
              "type": "boolean"
            },
            "endpoint": {
              "description": "服务端点地址",
              "type": "string"
            },
            "timeout_s": {
              "description": "请求超时（秒）",
              "type": "number"
            }
          }
        },
        "searxng": {
          "default": {
            "enabled": false,
            "endpoint": "http://127.0.0.1:50201",
            "timeout_s": 10
          },
          "type": "object",
          "properties": {
            "enabled": {
              "description": "是否启用该服务",
              "default": false,
              "type": "boolean"
            },
            "endpoint": {
              "description": "服务端点地址",
              "type": "string"
            },
            "timeout_s": {
              "description": "请求超时（秒）",
              "type": "number"
            }
          }
        },
        "cache_redis": {
          "type": "object",
          "properties": {
            "enabled": {
              "description": "是否启用该服务",
              "default": false,
              "type": "boolean"
            },
            "endpoint": {
              "description": "服务端点地址",
              "type": "string"
            },
            "timeout_s": {
              "description": "请求超时（秒）",
              "type": "number"
            }
          }
        }
      }
    },
    "storage": {
      "description": "存储设置：数据根目录路径",
      "type": "object",
      "properties": {
        "data_root": {
          "description": "运行时数据根目录路径，相对路径从 CWD 解析",
          "default": "./data",
          "type": "string"
        }
      }
    },
    "source_ingestion": {
      "description": "来源摄取安全策略：SSRF 白名单域名/IP、重定向限制",
      "type": "object",
      "properties": {
        "allowlist_only": {
          "description": "仅允许白名单中的主机访问，禁止所有未列出的地址",
          "default": false,
          "type": "boolean"
        },
        "allowlist_hosts": {
          "description": "白名单主机名列表（精确匹配）",
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowlist_domains": {
          "description": "白名单域名列表（子域名通配）",
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowlist_cidrs": {
          "description": "白名单 CIDR 网段列表",
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "max_redirects": {
          "description": "URL 获取时最大重定向次数",
          "default": 5,
          "type": "number"
        }
      }
    },
    "models": {
      "description": "模型配置：默认模型、可用模型列表、提供商配置",
      "type": "object",
      "properties": {
        "defaults": {
          "default": {},
          "type": "object",
          "properties": {
            "chat": {
              "type": "string"
            },
            "embedding": {
              "type": "string"
            },
            "edit": {
              "type": "string"
            },
            "autocomplete": {
              "type": "string"
            }
          }
        },
        "available": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "provider": {
                "type": "string"
              },
              "model": {
                "type": "string"
              },
              "display_name": {
                "type": "string"
              },
              "description": {
                "default": "",
                "type": "string"
              },
              "roles": {
                "default": [
                  "chat"
                ],
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "chat",
                    "embed",
                    "edit",
                    "apply",
                    "autocomplete",
                    "summarize"
                  ]
                }
              },
              "capabilities": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "tool_use",
                    "image_input",
                    "audio_input",
                    "streaming"
                  ]
                }
              },
              "provider_config": {
                "type": "object",
                "properties": {
                  "api_key": {
                    "type": "string"
                  },
                  "base_url": {
                    "type": "string"
                  },
                  "organization": {
                    "type": "string"
                  },
                  "project": {
                    "type": "string"
                  }
                }
              },
              "completion_options": {
                "type": "object",
                "properties": {
                  "context_length": {
                    "type": "number"
                  },
                  "max_tokens": {
                    "type": "number"
                  },
                  "temperature": {
                    "type": "number"
                  },
                  "top_p": {
                    "type": "number"
                  },
                  "top_k": {
                    "type": "number"
                  },
                  "stop": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "reasoning": {
                    "type": "boolean"
                  }
                }
              },
              "request_options": {
                "type": "object",
                "properties": {
                  "timeout": {
                    "type": "number"
                  },
                  "verify_ssl": {
                    "default": true,
                    "type": "boolean"
                  },
                  "proxy": {
                    "type": "string"
                  },
                  "headers": {}
                }
              },
              "sdk": {
                "type": "string"
              },
              "factory": {
                "type": "string"
              },
              "provider_options": {}
            }
          }
        }
      }
    },
    "providers": {
      "description": "AI 提供商配置：API key、base URL 等",
      "type": "object",
      "properties": {
        "api_key": {
          "type": "string"
        },
        "base_url": {
          "type": "string"
        },
        "organization": {
          "type": "string"
        },
        "project": {
          "type": "string"
        }
      }
    }
  },
  "additionalProperties": true
}
