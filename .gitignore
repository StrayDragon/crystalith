### Universal ###
# Common files that should be ignored in all projects

# Editor local artifacts
.zcode/

# Vibe coding images
.vibe-images

# Logs
*.log
# Temporary files
*.tmp
*~

*.bak
# Environment files (containing secrets, API keys, credentials)
.env
*.env
.env.*
!.env.example

# Overmind (local process manager socket)
.overmind.sock
.overmind.sock.*

# llman SDD local pageindex (regenerated by `llman sdd index rebuild`)
llmanspec/.context/pageindex/

# Local configuration that shouldn't be shared
*.local
*.local.*

# Crystalith secret env (runtime secrets)
config/secret.env

# Local runtime data (databases/uploads)
apps/server/data/
apps/server/slides/

