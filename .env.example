# These env vars are kept for v1 backward compatibility.
# New code MUST use CL_* variants where available.

# [DEPRECATED] 使用 CL_SEARXNG_HOST。SearXNG 实例 URL。
# SEARXNG_HOST=

# [DEPRECATED] 使用 CL_JINA_API_KEY。Jina Reader API 密钥。
# JINA_API_KEY=

# [DEPRECATED] 使用 CL_FIRECRAWL_API_KEY。Firecrawl API 密钥。
# FIRECRAWL_API_KEY=
