# ============================================================================
# Crystalith v2 Environment Configuration
#
# Quick start:  cp .env.example .env && just upsert-env-configs
# Then:         just dev   # overmind: server :8032 + web :3000 + slidev :3030
# Requires:     overmind + tmux on PATH
# Optional:     CL_SLIDEV_PORT=3030  SLIDEV_PREVIEW_PATH=apps/server/slides/preview/slides.md
# ============================================================================
#
# Runtime/business config lives in `config/app.yaml` (and `config/secret.env`).
# This file controls build/run parameters.
# ============================================================================

# ----------------------------------------------------------------------------
# Server (Bun + Elysia)
# ----------------------------------------------------------------------------
# Port for the v2 server (Bun --watch auto-reload)
CL_SERVER_PORT=8032

# ----------------------------------------------------------------------------
# Slidev preview (optional; started by Overmind `slidev` process)
# ----------------------------------------------------------------------------
# CL_SLIDEV_PORT=3030
# SLIDEV_PREVIEW_PATH=apps/server/slides/preview/slides.md
# VITE_SLIDEV_PREVIEW_URL=http://localhost:3030

# ----------------------------------------------------------------------------
# LLM Provider configs (non-secret)
# ----------------------------------------------------------------------------
# OpenAI-compatible API base URL (leave empty for default https://api.openai.com/v1)
OPENAI_BASE_URL=

# Default model IDs (referenced in config/app.yaml)
CRYSTALITH_DEFAULT_EMBEDDING_MODEL=
CRYSTALITH_DEFAULT_CHAT_MODEL=
