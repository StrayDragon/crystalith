# ----------------------------------------------------------------------------
# Crystalith - Production Docker Compose Environment
#
# Usage:
#   cp .env.example .env
#   docker compose --env-file .env -f deployments/prod/docker-compose.yml up -d --build
# ----------------------------------------------------------------------------

# Public web port (nginx)
CL_WEB_PORT=8080

# ----------------------------------------------------------------------------
# PostgreSQL
# ----------------------------------------------------------------------------
POSTGRES_USER=crystalith
POSTGRES_PASSWORD=crystalith
POSTGRES_DB=crystalith

# Backend database URL (async SQLAlchemy) — uses Docker DNS name "postgres"
DATABASE_URL=postgresql+asyncpg://crystalith:crystalith@postgres:5432/crystalith

# ----------------------------------------------------------------------------
# Optional Redis cache (enable by running: docker compose --profile redis ...)
# ----------------------------------------------------------------------------
CACHE_PROVIDER=memory
# Leave empty unless you enable the `redis` profile.
REDIS_URL=
# Example:
# REDIS_URL=redis://redis:6379/0

# ----------------------------------------------------------------------------
# AI providers (optional)
# ----------------------------------------------------------------------------
# API keys are secrets — set here for Docker Compose injection.
# Other AI settings (base_url, model defaults, etc.) are managed in config/app.yaml.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# For a VPN-hosted OpenAI-compatible proxy, use host.docker.internal + vpn-bridge:
# OPENAI_BASE_URL=http://host.docker.internal:50256/v1

# Ollama host URL. Ollama on the same machine is reachable via:
#   OLLAMA_HOST=http://host.docker.internal:11434
# Models are auto-discovered from Ollama on startup — any model you've pulled
# will appear automatically (no need to add them to config/app.yaml).
# Auto-discovered model IDs use the format: ollama:<model_name>
# Example: ollama:llama3.2, ollama:qwen2.5-coder:1.5b
OLLAMA_HOST=

# Optional model defaults (must match `id` field in config/app.yaml, NOT the raw model name)
# For Ollama offline mode, use: qwen-local / bge-m3-local (pre-configured)
#   or use auto-discovered IDs: ollama:qwen2.5-coder:1.5b / ollama:bge-m3:567m
# For OpenAI, use: gpt-5.2 / text-embedding-3-small
# Leave empty to use defaults from config/app.yaml
CRYSTALITH_DEFAULT_CHAT_MODEL=
CRYSTALITH_DEFAULT_EMBEDDING_MODEL=

# ----------------------------------------------------------------------------
# Host remap bridge (optional — enable with: --profile host-remap)
# ----------------------------------------------------------------------------
# If your AI services or search engine are on a VPN, Tailscale, or other networks
# that Docker bridge networking cannot reach directly, enable the host-remap profile:
#   just docker-compose-up-remap
#
# The host-remap container (network_mode: host) forwards ports from the host
# to remote endpoints. Other containers reach them via host.docker.internal:LOCAL_PORT.
#
# Format: space-separated entries of LOCAL_PORT:REMOTE_HOST:REMOTE_PORT
# Example (Tailscale):
#   BRIDGE_FORWARDS=50201:my-server.ts.net:50201 50256:my-server.ts.net:50256
#
# Leave empty if all external services are directly reachable (e.g., api.openai.com).
BRIDGE_FORWARDS=

# ----------------------------------------------------------------------------
# Optional: Image versions (advanced)
# ----------------------------------------------------------------------------
# Backend base image (must be Debian bookworm+)
PYTHON_IMAGE=python:3.12-slim-trixie

# uv image used to provide `uv` during docker builds (can be pinned to a digest)
UV_IMAGE=ghcr.io/astral-sh/uv:0.10.2

# Frontend build/runtime images
NODE_IMAGE=node:20-trixie-slim
NGINX_IMAGE=nginx:1.29.5-trixie
PNPM_VERSION=10.29.2

# Service images
POSTGRES_IMAGE=postgres:18.1-trixie
CHROMADB_IMAGE=chromadb/chroma:0.5.15
REDIS_IMAGE=redis:7.4-alpine
OLLAMA_IMAGE=ollama/ollama:latest
ALPINE_IMAGE=alpine:3.21

# ----------------------------------------------------------------------------
# Optional: China mirrors (build-time only)
# ----------------------------------------------------------------------------
# Debian APT mirror (example: https://mirrors.tuna.tsinghua.edu.cn/debian)
APT_MIRROR=

# uv/PyPI index (example: https://mirrors.aliyun.com/pypi/simple/)
UV_INDEX_URL=

# npm registry (example: https://registry.npmmirror.com)
NPM_REGISTRY=

# ----------------------------------------------------------------------------
# Optional docker secrets directory
# ----------------------------------------------------------------------------
# Example (Docker Compose secrets or bind-mount):
#   CRYSTALITH_SECRETS_PATH=/run/secrets
CRYSTALITH_SECRETS_PATH=
