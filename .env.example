# ============================================================================
# Crystalith v2 Environment Configuration
#
# Auto-generated from packages/shared/src/schemas/env.ts.
# DO NOT EDIT MANUALLY — edit the schema and run `just gen-env-examples`.
# ============================================================================
#
# Quick start:  cp .env.example .env && just upsert-env-configs
# Then:         just dev   # overmind: server :8032 + web :3000 + slidev :3030
# Requires:     overmind + tmux on PATH
# ============================================================================
#
# Runtime/business config lives in `config/app.yaml` (and `config/secret.env`).
# This file controls build/run parameters.
# ============================================================================

# ----------------------------------------------------------------------------
# Active configuration
# ----------------------------------------------------------------------------

# Elysia 服务器监听端口。默认 8032。
# CL_SERVER_PORT=

# Elysia 服务器监听地址。默认 127.0.0.1（仅本地）。生产部署设为 0.0.0.0。
# CL_SERVER_HOST=

# 所有运行时文件的统一数据根目录（DB、slides、uploads）。相对路径从 CWD 解析。
# CL_DATA_ROOT=

# SQLite 数据库文件路径。默认派生自 CL_DATA_ROOT → storage.data_root。
# CL_DB_PATH=

# YAML 配置文件路径。默认 config/app.yaml。
# CL_CONFIG_PATH=

# 密钥文件路径。默认 config/secret.env。
# CL_SECRET_PATH=

# OpenAI-compatible 聊天 API base URL。默认由 config/app.yaml 提供。
# CL_CHAT_API_BASE=

# OpenAI-compatible 嵌入 API base URL。默认由 config/app.yaml 提供。
# CL_EMBEDDING_API_BASE=

# OpenAI 兼容 API base URL（通用）。留空使用默认 https://api.openai.com/v1。
# OPENAI_BASE_URL=

# 默认聊天模型 ID。覆盖 config/app.yaml 中 models.defaults.chat。
# CL_DEFAULT_CHAT_MODEL=

# 默认嵌入模型 ID。覆盖 config/app.yaml 中 models.defaults.embedding。
# CL_DEFAULT_EMBEDDING_MODEL=

# 主聊天模型名称（gateway-chat-primary 的 model 字段）。
# CL_CHAT_MODEL=

# 轻量聊天模型名称（gateway-chat-light 的 model 字段）。
# CL_CHAT_LIGHT_MODEL=

# 嵌入模型名称（gateway-embedding 的 model 字段）。
# CL_EMBEDDING_MODEL=

# SearXNG 实例 URL。覆盖 config/app.yaml 中 search.searxng.host。留空禁用。
# CL_SEARXNG_HOST=

# Firecrawl API 根地址（自建可覆盖）。默认 https://api.firecrawl.dev；请求路径为 {base}/v2/scrape。
# CL_FIRECRAWL_API_BASE=

# Vite 开发服务器 API 代理目标地址。仅前端构建时使用。
# VITE_API_PROXY_TARGET=

# 设为 1 时生产构建也注册 /demo/research-lab（xlsx-lib 演示）；DEV 下始终可用。产品 /research-lab 始终为 Eden。
# VITE_LAB_DEMO=

# [DEPRECATED] 已忽略；请用 /demo/research-lab 与 VITE_LAB_DEMO。产品路径始终 Eden。
# VITE_LAB_FIXTURE=

# ----------------------------------------------------------------------------
