# ----------------------------------------------------------------------------
# Crystalith - Production Docker Compose Environment
#
# Usage:
#   cp .env.example .env
#   docker compose -f docker-compose.prod.yml up -d --build
# ----------------------------------------------------------------------------

# Public web port (nginx)
CL_WEB_PORT=8080

# ----------------------------------------------------------------------------
# PostgreSQL
# ----------------------------------------------------------------------------
POSTGRES_USER=crystalith
POSTGRES_PASSWORD=crystalith
POSTGRES_DB=crystalith

# Backend database URL (async SQLAlchemy)
DATABASE_URL=postgresql+asyncpg://crystalith:crystalith@postgres:5432/crystalith

# ----------------------------------------------------------------------------
# Optional Redis cache (enable by running: docker compose --profile redis ...)
# ----------------------------------------------------------------------------
CACHE_PROVIDER=memory
REDIS_URL=redis://redis:6379/0

# ----------------------------------------------------------------------------
# AI providers (optional)
# ----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_HOST=

# Optional model defaults (must match ids in config/app.yaml)
CRYSTALITH_DEFAULT_CHAT_MODEL=
CRYSTALITH_DEFAULT_EMBEDDING_MODEL=

# ----------------------------------------------------------------------------
# Optional docker secrets directory
# ----------------------------------------------------------------------------
# Example (Docker Compose secrets or bind-mount):
#   CRYSTALITH_SECRETS_PATH=/run/secrets
CRYSTALITH_SECRETS_PATH=
