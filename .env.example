# ============================================================================
# Crystalith Environment Configuration
#
# Quick start:  cp .env.example .env && just up
# 快速开始:     cp .env.example .env && just up
# ============================================================================
#
# Runtime/business config lives in `config/app.yaml` (and `config/secret.env`).
# This file controls the runtime profile and compose/build parameters.
#
# 运行时/业务配置在 `config/app.yaml`（和 `config/secret.env`）中。
# 本文件控制运行 profile 和 compose/构建参数。
# ============================================================================

# ----------------------------------------------------------------------------
# Runtime Profile (运行模式)
#
# Choose your profile, then run `just up`:
# 选择你的运行模式，然后执行 `just up`：
#
#   local   — Pure local dev, overmind only, no Docker
#             纯本地开发，仅 overmind，无 Docker
#   hybrid  — Docker deps + local hot-reload app (recommended for devs)
#             Docker 运行依赖 + 本地热重载应用（推荐开发者使用）
#   docker  — Docker Compose for app + selected deps; connect external services via config
#             Docker Compose 部署应用 + 部分依赖；通过配置连接外部服务
#   full    — Full Docker Compose deployment with all overlays
#             全 Docker Compose 部署，包含所有可选服务
# ----------------------------------------------------------------------------
CRYSTALITH_PROFILE=hybrid

# Services to include per profile (space-separated overlay names).
# Available: storage redis searxng ollama slidev host-remap
# 每个 profile 包含的服务（空格分隔的 overlay 名称）。
# 可选: storage redis searxng ollama slidev host-remap
HYBRID_SERVICES=storage redis searxng
DOCKER_SERVICES=storage redis searxng
FULL_SERVICES=storage redis searxng ollama slidev

# ----------------------------------------------------------------------------
# Core required (frontend + backend)
# ----------------------------------------------------------------------------
CL_WEB_PORT=8080

# ----------------------------------------------------------------------------
# Optional runtime overrides (non-secret)
# ----------------------------------------------------------------------------
# OpenAI-compatible endpoint override for Docker Compose (passed into the `api` container as `OPENAI_BASE_URL`,
# used by `{{ env.OPENAI_BASE_URL }}` in config/app.yaml).
# Leave empty to use the OpenAI SDK default (https://api.openai.com/v1).
OPENAI_BASE_URL=

# Default embedding model override for Docker Compose.
# Useful when your OpenAI-compatible gateway doesn't serve OpenAI embedding models (e.g. `text-embedding-3-*`).
# Example: `CRYSTALITH_DEFAULT_EMBEDDING_MODEL=bge-m3-openai`
CRYSTALITH_DEFAULT_EMBEDDING_MODEL=

# ----------------------------------------------------------------------------
# Optional overlay: searxng web search
#   -f deployments/prod/docker-compose.searxng.yml
# ----------------------------------------------------------------------------
SEARXNG_IMAGE=searxng/searxng:latest
SEARXNG_BASE_URL=
SEARXNG_SECRET=

# ----------------------------------------------------------------------------
# Optional overlay: host remap bridge
#   -f deployments/prod/docker-compose.host-remap.yml
# ----------------------------------------------------------------------------
# Format: LOCAL_PORT:REMOTE_HOST:REMOTE_PORT (space-separated)
BRIDGE_FORWARDS=

# ----------------------------------------------------------------------------
# Optional overlay: slidev preview
#   -f deployments/prod/docker-compose.slidev.yml
# ----------------------------------------------------------------------------
CL_SLIDEV_PORT=3030

# ----------------------------------------------------------------------------
# Dev deps compose (host hot reload + docker deps)
#   -f deployments/dev/docker-compose.deps*.yml
# ----------------------------------------------------------------------------
CL_DEPS_POSTGRES_PORT=5434
CL_DEPS_CHROMA_PORT=8001
CL_DEPS_REDIS_PORT=6380
CL_DEPS_OLLAMA_PORT=11434
CL_DEPS_SEARXNG_PORT=50201

# ----------------------------------------------------------------------------
# Optional backend extras (build-time)
# ----------------------------------------------------------------------------
# Space-separated uv extras for the API image build.
# Example: `official-slides` installs the official slides workflow plugin package.
CRYSTALITH_BACKEND_EXTRAS=

# ----------------------------------------------------------------------------
# Optional images (advanced)
# ----------------------------------------------------------------------------
PYTHON_IMAGE=python:3.12-slim-trixie
UV_IMAGE=ghcr.io/astral-sh/uv:0.11.1
NODE_IMAGE=node:20-trixie-slim
NGINX_IMAGE=nginx:1.29.5-trixie
PNPM_VERSION=10.29.2
POSTGRES_IMAGE=postgres:18.1-trixie
CHROMADB_IMAGE=chromadb/chroma:0.5.15
REDIS_IMAGE=redis:7.4-alpine
OLLAMA_IMAGE=ollama/ollama:latest
ALPINE_IMAGE=alpine:3.21

# ----------------------------------------------------------------------------
# Optional mirrors (build-time only)
# ----------------------------------------------------------------------------
APT_MIRROR=
UV_INDEX_URL=
NPM_REGISTRY=
