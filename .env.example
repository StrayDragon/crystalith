# ----------------------------------------------------------------------------
# Crystalith Compose Environment (core + optional overlays)
#
# Core only:
#   docker compose --env-file .env -f deployments/prod/docker-compose.yml up -d --build
#
# Example (core + storage + redis + ollama):
#   docker compose --env-file .env \
#     -f deployments/prod/docker-compose.yml \
#     -f deployments/prod/docker-compose.storage.yml \
#     -f deployments/prod/docker-compose.redis.yml \
#     -f deployments/prod/docker-compose.ollama.yml \
#     up -d --build
# ----------------------------------------------------------------------------

# ----------------------------------------------------------------------------
# Core required (frontend + backend)
# ----------------------------------------------------------------------------
CL_WEB_PORT=8080

# API keys are optional; set when using hosted providers.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Optional model defaults (must match model IDs in config/app.yaml)
CRYSTALITH_DEFAULT_CHAT_MODEL=
CRYSTALITH_DEFAULT_EMBEDDING_MODEL=

# Optional docker secrets path mounted into container
CRYSTALITH_SECRETS_PATH=

# ----------------------------------------------------------------------------
# Optional overlay: storage (postgres + chromadb)
#   -f deployments/prod/docker-compose.storage.yml
# ----------------------------------------------------------------------------
POSTGRES_USER=crystalith
POSTGRES_PASSWORD=crystalith
POSTGRES_DB=crystalith
DATABASE_URL=postgresql+asyncpg://crystalith:crystalith@postgres:5432/crystalith
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# ----------------------------------------------------------------------------
# Optional overlay: redis cache
#   -f deployments/prod/docker-compose.redis.yml
# ----------------------------------------------------------------------------
CACHE_PROVIDER=memory
REDIS_URL=
# Example:
# CACHE_PROVIDER=redis
# REDIS_URL=redis://redis:6379/0

# ----------------------------------------------------------------------------
# Optional overlay: ollama local models
#   -f deployments/prod/docker-compose.ollama.yml
# ----------------------------------------------------------------------------
# If using local Ollama in compose overlay, default is http://ollama:11434.
# If using host Ollama, set: http://host.docker.internal:11434
OLLAMA_HOST=

# Runtime monitor: probes Ollama and auto-discovers models after backend startup.
CRYSTALITH_OLLAMA_MONITOR_ENABLED=1
CRYSTALITH_OLLAMA_MONITOR_INTERVAL_S=15
CRYSTALITH_OLLAMA_MONITOR_TIMEOUT_S=3
CRYSTALITH_OLLAMA_MONITOR_INCLUDE_ENV_HOST=0

# ----------------------------------------------------------------------------
# Optional overlay: host remap bridge
#   -f deployments/prod/docker-compose.host-remap.yml
# ----------------------------------------------------------------------------
# Format: LOCAL_PORT:REMOTE_HOST:REMOTE_PORT (space-separated)
BRIDGE_FORWARDS=

# ----------------------------------------------------------------------------
# Optional overlay: slidev preview
#   -f deployments/prod/docker-compose.slidev.yml
# ----------------------------------------------------------------------------
CL_SLIDEV_PORT=3030

# ----------------------------------------------------------------------------
# Optional images (advanced)
# ----------------------------------------------------------------------------
PYTHON_IMAGE=python:3.12-slim-trixie
UV_IMAGE=ghcr.io/astral-sh/uv:0.10.2
NODE_IMAGE=node:20-trixie-slim
NGINX_IMAGE=nginx:1.29.5-trixie
PNPM_VERSION=10.29.2
POSTGRES_IMAGE=postgres:18.1-trixie
CHROMADB_IMAGE=chromadb/chroma:0.5.15
REDIS_IMAGE=redis:7.4-alpine
OLLAMA_IMAGE=ollama/ollama:latest
ALPINE_IMAGE=alpine:3.21

# ----------------------------------------------------------------------------
# Optional mirrors (build-time only)
# ----------------------------------------------------------------------------
APT_MIRROR=
UV_INDEX_URL=
NPM_REGISTRY=
