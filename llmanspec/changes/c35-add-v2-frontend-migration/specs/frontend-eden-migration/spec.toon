kind: llman.sdd.delta
ops[3]{op,req_id,title,statement,from,to,name}:
  add_requirement,fm1,"Frontend API Client","The frontend MUST use eden treaty for all backend HTTP calls and MUST NOT import from api/generated/.",null,null,null
  add_requirement,fm2,"Streaming Endpoints","Streaming endpoints MUST use fetch() with manual SSE parsing against /v2/* URLs; SSE URLs MUST NOT reference /v1/.",null,null,null
  add_requirement,fm3,"Code Cleanup","The api/generated/ directory MUST be deleted after all references are migrated.",null,null,null
op_scenarios[3]{req_id,id,given,when,then}:
  fm1,generated-client-eliminated,"The frontend imports api/generated client","all imports are replaced with api/eden treaty calls","typecheck reports 0 generated client references"
  fm2,streaming-migrated,"A streaming feature like chat QA is used","the client sends a streaming request","the request hits /v2/qa/stream and SSE events are correctly parsed"
  fm3,cleanup-complete,"All generated client references have been migrated","the api/generated/ directory is deleted","typecheck and tests pass with 0 generated client errors"
