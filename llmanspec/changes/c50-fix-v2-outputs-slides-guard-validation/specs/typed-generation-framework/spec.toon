kind: llman.sdd.delta
ops[2]{op,req_id,title,statement,from,to,name}:
  add_requirement,outputs-citations-must-be-sanitized,"Outputs pipeline MUST sanitize citation indices (range/dup/int) with warnings","outputs pipeline MUST 实现 sanitize_citations_indices（对齐 v1 output_postprocess.py:293-346）：递归剥离越界、重复、非整数 citation 索引，设置 _warnings/citations_sanitized 标记与 _postprocessed:true。当前 v2 mapCitationsIntoContent（pipeline.ts:421-449）只做 .filter undefined 静默丢弃，不 dedupe、不发警告、不设 _postprocessed 标记；c38 proposal 第 3 项承诺的 sanitizeCitationsIndices 未兑现",null,null,null
  add_requirement,outputs-quality-preference-must-trigger-llm-repair,"Outputs pipeline with preference=quality MUST run LLM repair loop for salvageable output","outputs pipeline 在 preference=quality 且 needs_repair 检测到空/缺字段时 MUST 运行 LLM repair loop（对齐 v1 output_graph.py:595-719 的 PostprocessOutput 节点 + output_postprocess.py:192-290 的 needs_repair），用第二次 LLM pass 修补可挽救的不完整输出，而非直接降级到 fallback 内容。当前 v2 pipeline.ts:185-199 无 repair loop、无 needs_repair，生成失败直接走 fallback，对 quality 请求降级更激进",null,null,null
op_scenarios[2]{req_id,id,given,when,then}:
  outputs-citations-must-be-sanitized,citation-out-of-range,"生成 content 含越界 citation 索引（如 [99] 但只有 3 个 citation）","系统 postprocess","SHALL 剥离越界索引并设 _postprocessed/_warnings 标记（与 v1 一致）"
  outputs-quality-preference-must-trigger-llm-repair,quality-repair,"preference=quality 且输出有可修补的缺字段","系统 postprocess","SHALL 触发 LLM repair loop 尝试修补，而非直接 fallback"
