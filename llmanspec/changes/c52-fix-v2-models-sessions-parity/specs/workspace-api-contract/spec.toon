kind: llman.sdd.delta
ops[5]{op,req_id,title,statement,from,to,name}:
  add_requirement,models-list-must-return-providers-envelope,"Models list MUST return providers field on the list envelope (not only separate endpoint)","models 列表端点 MUST 在响应 envelope 返回 providers 字段（对齐 v1 ModelsListResponse, api.py:42-43 与 95-97：sorted({openai} ∪ plugins.list_ai_providers())），MUST NOT 只在单独的 /models/providers 端点暴露；当前 v2 router.ts:43-56 envelope 缺 providers 字段，前端读 resp.providers 会 break",null,null,null
  add_requirement,models-must-filter-by-provider-availability,"Models endpoints MUST filter by provider availability like v1","models GET list 与 GET single MUST 按 provider 可用性过滤（对齐 v1 api.py:83 与 109-110 用 plugins.is_provider_available）：未配置 provider 的 model 在 list 中不出现，GET single 时返回 404；当前 v2 router.ts:38-42 只按 role 过滤、shared/config.ts:213-215 的 getModelById 做裸 find 无 provider 检查，未配置 provider 的 model 仍会出现",null,null,null
  add_requirement,sessions-convert-must-honor-message-ids,"Sessions convert-to-source and convert-to-output MUST honor message_ids filter","sessions 的 convert-to-source 与 convert-to-output MUST 接受 message_ids 过滤（对齐 v1 api.py:34-41 与 51-57 与 257-268 与 417-428）：仅转换指定消息，缺失 id 时 404；当前 v2 router.ts:185（convert-to-source）无 request body schema、总是转换所有消息，router.ts:298（convert-to-output）只读 output_type 不读 message_ids。多轮历史无法选择性转换",null,null,null
  add_requirement,sessions-convert-text-format-must-align-v1,"Sessions convert text format MUST match v1 role labels and separators","sessions convert 的文本格式 MUST 对齐 v1：(1) convert-to-source 用中文角色标签 **用户**:/**助手**: + \\n\\n 分隔（v1 api.py:110-123），当前 v2 router.ts:203-208 用英文 **Assistant**:/**User**: + \\n\\n---\\n\\n。(2) convert-to-output 用 raw 文本（无角色前缀，v1 text_format=raw, api.py:438），当前 v2 router.ts:314-319 加 [Assistant]/[User] 前缀。跨版本导出内容 diff 噪音",null,null,null
  add_requirement,models-response-default-shape-must-align-v1,"Models response MUST put defaults on envelope (not inline per-model) for list endpoint","models 列表端点 MUST 把 default_chat/default_embedding 放在 envelope 顶层（对齐 v1 api.py:42-43 与 96-97），GET single 不返回 default 信息（对齐 v1 get_model 返回裸 ModelRead）；当前 v2 router.ts:53-54 给每个 model 挂 is_default_chat/is_default_embedding，GET single 也内联默认标记，与 v1 契约不一致",null,null,null
op_scenarios[5]{req_id,id,given,when,then}:
  models-list-must-return-providers-envelope,read-providers,"前端读 GET /models 响应的 providers 字段","系统返回 models list","envelope SHALL 含 providers 字段（与 v1 一致）"
  models-must-filter-by-provider-availability,unconfigured-provider-model,"某 model 的 provider 未配置","系统返回 models list / GET single","该 model SHALL 不出现在 list；GET single SHALL 404"
  sessions-convert-must-honor-message-ids,convert-subset,"客户端传 message_ids=[1,3] 转换","系统执行 convert-to-source/output","SHALL 仅转换消息 1 与 3；缺失 id → 404"
  sessions-convert-text-format-must-align-v1,convert-text-format,"用户转换 session 为 source/output","系统生成文本","source 用中文角色标签 + \\n\\n；output 用 raw 文本（与 v1 一致）"
  models-response-default-shape-must-align-v1,defaults-envelope,"前端读 GET /models 的默认 model","系统返回 list","default_chat/default_embedding SHALL 在 envelope 顶层（非每 model 内联）"
