kind: llman.sdd.delta
ops[4]{op,req_id,title,statement,from,to,name}:
  add_requirement,r1,"Eden RPC replaces OpenAPI generation","前端 MUST 使用 Elysia eden treaty 调用 server API。import type { App } from @crystalith/server 后 treaty<App>(url) 提供端到端类型安全 RPC。MUST NOT 使用 @hey-api/openapi-ts 生成新代码。",null,null,null
  add_requirement,r2,"Gradual migration from generated client","已有 generated client 调用 MUST 逐步迁移到 eden RPC。每个 domain 迁移时 MUST 删除对应 generated import 并验证类型正确。",null,null,null
  add_requirement,r3,"Shared Zod schemas for request/response","前后端共享的 Zod schema MUST 放在 packages/shared/。Elysia 端点 MUST 使用相同 schema 校验入参，前端 MUST 复用同 schema 做客户端校验。",null,null,null
  add_requirement,r4,"Generated artifacts marked for removal","openapi.gen.json 和 src/api/generated/ MUST 在 Phase 5 删除。迁移期间 MAY 保留作为对照和 fallback。CI drift check 不再需要。",null,null,null
op_scenarios[4]{req_id,id,given,when,then}:
  r1,happy,"","前端调用 api.notebooks.list()","eden treaty 推断返回类型为 Notebook[]，TS 编译验证通过"
  r2,happy,"","迁移 notebooks domain 的 API 调用","删除 generated import，改为 eden treaty，类型检查无错误"
  r3,happy,"","server 定义 Zod schema: z.object({name: z.string()})","前端 import 同 schema 做客户端校验，server 也用它"
  r4,happy,"","Phase 5 清理","openapi.gen.json 和 src/api/generated/ 删除，前端仍正常编译"
