kind: llman.sdd.delta
ops[5]{op,req_id,title,statement,from,to,name}:
  add_requirement,r1,"Analysis runs clustering + contradiction detection","资料分析 MUST 支持聚类 (按主题分组 sources)、矛盾检测 (标记冲突 claims)、相关性分析 (similar sources)。",null,null,null
  add_requirement,r2,"Studio generates Slidev-compatible slides","幻灯片工作室 MUST 生成 Slidev markdown 格式 slides。AI SDK streamText 流式生成每页 slide 内容。",null,null,null
  add_requirement,r3,"Refine supports multiple modes","Refine MUST 支持扩展/缩写/重写/翻译四种模式。每种模式 MUST 通过不同的 system prompt 实现。MUST 保留上下文可追溯性 (refine 前后对照)。",null,null,null
  add_requirement,r4,"Templates use Nunjucks rendering","templates MUST 使用 Nunjucks 模板引擎渲染 (前端已在用)。MUST 支持内置 template 和用户自定义 template。",null,null,null
  add_requirement,r5,"Prompt presets configurable system prompts","prompt_presets MUST 支持定义可复用的 system prompt 预设。QA/Output/Research MAY 选择 preset 决定行为。",null,null,null
op_scenarios[5]{req_id,id,given,when,then}:
  r1,happy,"","Notebook 有 20 个 sources","聚类返回 5 个主题分组，矛盾检测标记 3 对冲突"
  r2,happy,"","用户请求生成 slides","流式生成 10 页 Slidev markdown，前端实时预览"
  r3,happy,"","用户选中一段回答 refine 为摘要","返回精炼后文字，保留引用"
  r4,happy,"","用户创建 FAQ template config","Nunjucks 渲染 template 产出 system prompt"
  r5,happy,"","QA 选择 analysis preset","QA 使用分析型 system prompt，回答更深入"
