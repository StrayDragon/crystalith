kind: llman.sdd.delta
ops[7]{op,req_id,title,statement,from,to,name}:
  add_requirement,r2a,"Refine MUST retrieve via vector search","系统 MUST 在 refine 请求携带 source_ids 时通过向量检索从相关 chunk 获取上下文 并附 citations 返回 而非拼接全部 chunk 文本或接受字面 text 输入",null,null,null
  add_requirement,r6,"Refine MUST support three summary formats","系统 MUST 支持 paragraph 段落摘要 与 bullets 要点列表 与 structured 结构化 title/bullets/terms 三种 refine 格式 每种格式有对应的 LLM 指令和后处理",null,null,null
  add_requirement,r7,"Refine MUST support batch multi-format concurrency","系统 MUST 提供 batch refine 端点 一次请求对多个格式并发生成 共享同一检索上下文与 citations",null,null,null
  add_requirement,r8,"Refine MUST validate request bounds","系统 MUST 校验 prompt 非空 与 format 属于允许集合 与 source_ids 为正整数且去重且在 notebook 内存在 与 top_k 在 1 到 20 与 min_score 在 0 到 1 否则返回 400",null,null,null
  add_requirement,r9,"Refine citations MUST include enriched fields","系统 MUST 在 refine 返回的 citations 中包含 source_name(hydrate filename) 与 snippet(先 strip 再截 200 字符) 与 page_number(从 chunk metadata 提取) 与 paragraph_index(从 chunk metadata 提取)",null,null,null
  add_requirement,r10,"Refine context MUST use full text numbered format","系统 MUST 用完整未截断的 chunk text 构建 LLM context 格式为 N-based 编号的 Source filename chunk index 与 text 块 以空行连接",null,null,null
  add_requirement,r11,"Refine error handling MUST use correct status codes","系统 MUST 在 notebook 不存在时返回 404 与 format 非法或 source_ids 未知时返回 400 与任务取消时返回 409 与任务失败时返回 500",null,null,null
op_scenarios[10]{req_id,id,given,when,then}:
  r2a,refine-with-source-ids,"notebook 有已索引的 source 和 chunk","用户发起 refine 请求携带 prompt 和 source_ids","系统 SHALL 向量检索相关 chunk 并附 citations 返回"
  r2a,refine-no-source-ids,"用户发起 refine 请求不携带 source_ids","请求到达 refine 端点","系统 SHALL 返回 evidence=false 且 citations 为空"
  r6,refine-structured-fallback,"structured 格式 LLM 输出非合法 JSON","applyFormat 解析结果","系统 SHALL 回退为 fallback structured 含 title 为 prompt 片段 且 bullets 为 citation snippets"
  r6,refine-parse-bullets,"bullets 格式 LLM 输出含前导短横线行","parseBullets 逐行处理","系统 SHALL 对每行 strip 加 lstrip 短横线 加 strip 后仅保留非空行 不匹配 圆点 或星号 或数字"
  r7,refine-batch-shared-context,"用户发起 batch refine 携带多个格式","请求到达 batch 端点","系统 SHALL 仅检索一次并为所有格式共享同一 citations 和 context"
  r10,refine-context-full-text,"检索返回多个 chunk","构建 LLM context","系统 SHALL 用完整未截断 text 并以 N-based 编号 Source filename chunk index 格式拼接"
  r8,refine-invalid-format,"用户提交非法 format 值","请求到达 refine 端点","系统 SHALL 返回 400 Unsupported refine format"
  r8,refine-duplicate-source-ids,"用户提交含重复 source_ids","请求到达 refine 端点","系统 SHALL 去重后校验存在性"
  r9,refine-citation-snippet-strip,"检索到的 chunk text 含首尾空白","构建 citation snippet","系统 SHALL 先 trim 再 slice 0 到 200 字符"
  r11,refine-task-cancelled,"单格式 refine 任务在队列中被取消","waitForCompletion 抛出 Task cancelled","系统 SHALL 返回 409 Task cancelled"
