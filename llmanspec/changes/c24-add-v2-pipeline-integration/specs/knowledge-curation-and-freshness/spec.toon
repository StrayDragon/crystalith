kind: llman.sdd.delta
ops[4]{op,req_id,title,statement,from,to,name}:
  add_requirement,r_tool_approval,"Research HITL via toolApproval","研究智能体 MUST 使用 AI SDK v7 toolApproval user-approval 实现事件驱动审批 替代 DB 轮询",null,null,null
  add_requirement,r_resume_with_state,"Research resume preserves state","研究 resume MUST 从 aggregatedResults 与 currentIteration 重建 ResearchState 而非从空结果重跑",null,null,null
  add_requirement,r_export_to_source,"Research export creates source","研究 export MUST 将 report 经 chunk 与 embed 与 vector 写入并创建 source 而非仅返回原始 JSON",null,null,null
  add_requirement,r_modify_action,"Research HITL modify action","研究 MUST 支持 modify 动作 接受修改后的 SearchPlan 记录 step 并 resume",null,null,null
op_scenarios[4]{req_id,id,given,when,then}:
  r_tool_approval,no_db_polling,"研究运行至 plan 阶段","agent 等待用户审批","系统 SHALL 通过 toolApproval 事件而非 DB 轮询阻塞"
  r_resume_with_state,resume_keeps_results,"研究已积累结果后取消","用户请求 resume","系统 SHALL 从上次 iteration 与累积结果续接"
  r_export_to_source,export_creates_source,"研究完成有 final report","用户请求 export","系统 SHALL 创建 source 并 chunk 与 embed 写入"
  r_modify_action,modify_then_resume,"研究等待审批","用户提交修改后的 plan","系统 SHALL 记录修改并 resume 执行新 plan"
