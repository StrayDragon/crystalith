kind: llman.sdd.delta
ops[4]{op,req_id,title,statement,from,to,name}:
  add_requirement,r13,"Source dedup_key MUST be computed and enforced","源上传/URL 导入 MUST 计算 dedup_key（upload: sha256(raw)，url: sha256(canonical_url)）并写入 sources.dedup_key。dedup_action 参数 MUST 支持 prompt(409)/reuse(200)/create_new。MUST NOT 留 dedup_key 列为空。",null,null,null
  add_requirement,r14,"URL fetch MUST be SSRF-guarded","/from-url 端点 MUST 经 SSRF 守卫：拒绝 loopback/private/link-local/元数据 IP(169.254.169.254)、拒绝非 http(s) scheme、拒绝 userinfo、DNS 解析后逐 IP 校验。MUST NOT 裸 fetch 任意 URL。",null,null,null
  add_requirement,r15,"URL canonicalization for dedup MUST strip tracking params","URL 规范化 MUST 去除跟踪参数（utm_*/gclid/fbclid 等）、排序 query、strip 默认端口与 fragment，确保同内容不同跟踪参数的 URL 产生相同 dedup_key。",null,null,null
  add_requirement,r16,"Upload MUST enforce size limit","源上传 MUST 强制大小限制（upload_max_bytes），超限返回 413。MUST NOT 无限制接受上传。",null,null,null
op_scenarios[4]{req_id,id,given,when,then}:
  r13,happy,"notebook 已有 dedup_key=X 的源","再次上传同内容（dedup_action=prompt）","返回 409 SOURCE_DEDUP_HIT + existing_source_id"
  r14,happy,"请求导入 http://10.0.0.1/secret","/from-url","SSRF 守卫拒绝（私网 IP），不发起 fetch"
  r15,happy,"URL A=?utm_source=x&B=2 与 B=2（无 utm）","计算 dedup_key","两 URL 产生相同 dedup_key"
  r16,happy,"上传 100MB 文件（限制 50MB）","upload","返回 413 PAYLOAD_TOO_LARGE"
