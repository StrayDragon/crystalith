kind: llman.sdd.delta
ops[2]{op,req_id,title,statement,from,to,name}:
  add_requirement,"studio-generation-config-must-expand-to-ranges","Studio generation MUST interpret generation_config with concrete ranges not raw tokens","studio outline 与 markdown 生成 MUST 解读 slide.generation_config 的 quantity/density/audience/tone/structure/language/theme_preset 字段并展开为具体区间与本地化提示（对齐 v1 generator.py:202-290 的 _build_outline_prompt/_build_markdown_prompt）。quantity MUST 映射为 slide 数量区间（short=6-8/standard=8-12/detailed=12-18），density MUST 映射为要点区间（sparse=2-3/standard=3-5/dense=5-7）。generation_config.preference (quality/speed) MUST 影响检索参数（topK/minScore，对齐 v1 generation_preference.py 的 SLIDES tuning）。MUST NOT 把原始字段 id（如 'standard'）直接拼进 prompt 而不做展开。",null,null,null
  add_requirement,"studio-frontmatter-must-align-v1-six-key-shape","Studio frontmatter MUST use the v1 six-key template shape with override support","studio 生成的 markdown frontmatter MUST 对齐 v1 THEME_PRESET_TEMPLATES 的 6-key 结构（theme 恒为 default、colorSchema、fonts{sans,serif,mono}、transition、background、class）。当 generation_config.frontmatter 非空时，MUST 以该字符串作为 frontmatter body 绕过 preset（对齐 v1 _normalize_frontmatter_override），仅在缺 title: 且存在标题时补一行。MUST NOT 使用与 v1 不同的 slidev 主题名（如 seriph/bricks）或省略 colorSchema/class/serif/mono 字段。",null,null,null
op_scenarios[4]{req_id,id,given,when,then}:
  "studio-generation-config-must-expand-to-ranges","quantity-expands-to-range","a slide draft has generation_config.quantity='detailed'","the system builds the outline/markdown generation prompt","the prompt MUST reference the concrete range 12-18 slides (not the literal string 'detailed')"
  "studio-generation-config-must-expand-to-ranges","preference-tunes-retrieval","a slide draft has generation_config.preference='quality'","the system retrieves context for generation","the retrieval MUST use a larger topK and lower minScore than the speed/default profile (quality topK=12 minScore=0.1)"
  "studio-frontmatter-must-align-v1-six-key-shape","frontmatter-has-all-six-keys","a slide is generated with theme_preset='minimal-clean'","the system writes the markdown frontmatter","the frontmatter MUST contain theme: default, colorSchema, fonts (sans+serif+mono), transition, background, and class keys matching v1 THEME_PRESET_TEMPLATES.minimal-clean verbatim"
  "studio-frontmatter-must-align-v1-six-key-shape","frontmatter-override-bypasses-preset","a slide draft has generation_config.frontmatter set to a non-empty string","the system writes the markdown frontmatter","the system MUST use the override string as the frontmatter body (cleaned of surrounding fences) instead of the theme preset template"
