kind: llman.sdd.delta
ops[5]{op,req_id,title,statement,from,to,name}:
  add_requirement,"research-skip-must-run-analyze","Research skip MUST run Analyze before next iteration","research agent 的 skip 动作 MUST 在进入下一轮 plan 之前对累积搜索结果执行 Analyze 步骤（对齐 v1 graph.py:364 WaitForApproval skip→AnalyzeResults），以保留分析信号供报告生成。MUST NOT 直接跳到下一轮 plan 而丢弃 analyze。",null,null,null
  add_requirement,"research-finish-fallback-must-be-real-content","Research finish fallback MUST be real content not sentinel string","research finish 端点触发报告生成时，若 LLM 调用失败，MUST 从累积搜索结果合成有意义的中文 fallback 报告（含结果列表摘要）。MUST NOT 持久化技术性哨兵字符串（如 '(report generation failed)'）作为 finalReport——哨兵会通过 export 守卫（if finalReport 非空）产生垃圾 source。",null,null,null
  add_requirement,"research-plan-must-feed-prior-suggested-queries","Research plan MUST feed prior analysis suggested queries into next plan","research agent 的 plan 阶段 MUST 将上一轮 analyze 产生的 suggested_queries 作为 'Suggested focus areas' 传入下一轮 plan prompt（对齐 v1 graph.py:170-171）。MUST NOT 丢弃 analyze 的 suggested_queries 导致 reflect→plan 反馈环断裂。",null,null,null
  add_requirement,"research-lock-must-renew-periodically","Research lock MUST renew periodically not per-iteration","research agent 持有的运行锁 MUST 以周期性心跳续期（约每 300s）。MUST NOT 仅按迭代续期——单迭代耗时（多 LLM 调用 + 搜索）超过锁 TTL（10min）时会导致锁过期被 cleanupExpiredLocks 误清理。续期心跳 MUST 在所有退出路径（正常结束 / cancel / 异常）清理。",null,null,null
  add_requirement,"research-stream-must-auto-resume-stalled","Research stream endpoint MUST auto-resume stalled sessions","research SSE stream 端点 MUST 在连接时检测 stalled 会话（status 为 active 但锁未持有 / 已过期），并自动触发 resume（对齐 v1 api.py:972-983 _should_resume_research）。MUST NOT 要求客户端手动调 /resume 才能恢复卡住的会话。",null,null,null
op_scenarios[5]{req_id,id,given,when,then}:
  "research-skip-must-run-analyze","skip-runs-analyze","research is WAITING_USER with accumulated results from 2 iterations","the user calls skip","the system MUST execute an Analyze step on the accumulated results before proceeding to the next plan iteration"
  "research-finish-fallback-must-be-real-content","finish-llm-failure-synthesizes-fallback","research has accumulated 5 search results","finish triggers report generation but the LLM call fails","the system MUST synthesize a meaningful markdown report from the results list (not persist a sentinel string)"
  "research-plan-must-feed-prior-suggested-queries","suggested-queries-in-next-plan","research completes iteration 1 analysis which produced suggested_queries","the system builds the iteration 2 plan prompt","the prompt MUST include the suggested queries as focus areas"
  "research-lock-must-renew-periodically","long-iteration-keeps-lock","a research iteration takes 12 minutes (slow model)","the lock TTL is 10 minutes","the periodic renewal (every 300s) MUST keep the lock alive so it is not cleaned up mid-iteration"
  "research-stream-must-auto-resume-stalled","reconnect-triggers-resume","a research session is active but its lock expired (process crashed)","a client reconnects to the SSE stream","the stream handler MUST detect the stalled state and trigger an automatic resume"
