kind: llman.sdd.delta
ops[4]{op,req_id,title,statement,from,to,name}:
  add_requirement,r441,"Eden Lab report revisions use server API","Eden 模式下 LabReportPage MUST 经 GET/POST …/revisions 与 POST …/revisions/:revId/restore 列出、创建与恢复修订快照；恢复后画布与报告 MUST 反映服务端快照（经 GET run 或 graph_patch）；MUST NOT 以 sessionStorage labRevisions 作为 Eden 默认权威（落实 r419 Lab 路径）。",null,null,null
  add_requirement,r442,"Eden report CoW uses server working endpoints","Eden 模式下报告编辑 working copy MUST 经 GET/PUT …/report/working 读写；提交权威报告 MUST 经 PUT …/report；丢弃副本 MUST 调用服务端 discard（或等价端点）；MUST NOT 以 reportCow localStorage 作为 Eden 默认持久化。",null,null,null
  add_requirement,r443,"Eden convert invokes research convert endpoints","Eden 模式下报告页与节点抽屉的转化 MUST 调用 POST …/convert-to-note 或 convert-to-source，body 使用 ResearchArtifactRef（report、node 或 evidence）；成功或失败 MUST 以 toast 反馈且无强制确认对话框（对齐 r409）。",null,null,null
  add_requirement,r444,"Fixture revisions and CoW stay under explicit switch","labRevisions、reportCow 与 sessionStorage 修订演示 MUST 仅在 fixture 模式（VITE_LAB_FIXTURE=1 或 mode=fixture）保留；Eden 默认路径 MUST NOT 读写这些本地 store 作为权威。",null,null,null
op_scenarios[8]{req_id,id,given,when,then,feature}:
  r441,"eden-list-revisions-from-api",Eden 报告页已打开且 Run 有 revisions,用户查看修订列表,数据来自 GET revisions 而非 sessionStorage,true
  r441,"restore-revision-refreshes-lab",用户恢复某 revision,恢复成功,图与报告反映快照内容,true
  r442,"eden-save-working-via-put",用户在 Eden 报告页编辑,保存草稿,PUT report/working 成功且无 localStorage CoW,true
  r442,"eden-discard-working-via-api",Eden 报告存在 working 副本,用户丢弃,调用服务端 discard 且 UI 回权威报告,true
  r443,"convert-report-to-note-toast",Eden 报告页用户转笔记且 API 成功,观察反馈,成功 toast 且无强制对话框,true
  r443,"convert-node-via-artifact-ref",Eden 节点抽屉用户转来源,API 成功,请求体含 kind=node 与 nodeId,true
  r444,"fixture-keeps-lab-revisions",Lab 以 fixture 模式打开报告页,用户操作 revisions,MAY 使用 labRevisions sessionStorage,true
  r444,"eden-not-sessionstorage-revisions",Eden 报告页打开,检查 revisions 数据源,不经 labRevisions 本地 store,true
