kind: llman.sdd.delta
ops[3]{op,req_id,title,statement,from,to,name}:
  add_requirement,"notebook-scoped-resource-access","Notebook-scoped resources require notebook boundary","对 source、output、research session、studio slide、task 及 citation 单资源的读取与变更，系统 MUST 能证明请求属于某一 notebook：notebookId（query 或 path）MUST 为必填；当资源存在但不属于该 notebook 时 MUST 返回 404 NOT_FOUND，且 MUST NOT 在缺少 notebook 范围时按全局 id 返回跨 notebook 数据。",null,null,null
  add_requirement,"notebook-scoped-list-forbid-global","Notebook-scoped lists MUST NOT dump all notebooks","笔记本范围列表端点（至少包括 GET /v2/research）在缺少 notebook 过滤时 MUST 拒绝请求（400）；MUST NOT 返回全部 notebook 的聚合列表。",null,null,null
  add_requirement,"domain-errors-use-envelope-and-status","Domain conflicts use AppHttpError envelope","业务状态机非法与乐观锁冲突 MUST 通过 AppHttpError 返回统一 ErrorEnvelope：乐观锁冲突 MUST 使用 409 CONFLICT；非法状态转换 MUST 使用 400 INVALID_REQUEST 或 409 CONFLICT；MUST NOT 用裸 Error 落入非结构化 500，也 MUST NOT 用 NotFoundError 伪装冲突。",null,null,null
op_scenarios[4]{req_id,id,given,when,then,feature}:
  "notebook-scoped-resource-access","cross-notebook-source-get-404","存在属于 notebook A 的 source","客户端用 notebook B 的 notebookId 请求该 source","系统 SHALL 返回 404 NOT_FOUND 且响应为 ErrorEnvelope",false
  "notebook-scoped-resource-access","missing-notebook-id-rejected","客户端调用需归属校验的 source/output 单资源端点且省略 notebookId","发送请求","系统 SHALL 拒绝该请求（400 校验失败或等价）且 MUST NOT 返回跨本资源体",false
  "notebook-scoped-list-forbid-global","research-list-requires-notebook","系统中存在多个 notebook 的 research session","客户端调用 GET /v2/research 且省略 notebookId","系统 SHALL 拒绝全表列举（400）且 MUST NOT 返回全部 session",false
  "domain-errors-use-envelope-and-status","session-revision-conflict-409","客户端以过期 sharedStateRevision 更新 session","发生乐观锁冲突","系统 SHALL 返回 409 CONFLICT 与 ErrorEnvelope，且 MUST NOT 返回伪装的 404",false
