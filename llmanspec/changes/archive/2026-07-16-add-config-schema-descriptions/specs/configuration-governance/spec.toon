kind: llman.sdd.delta
ops[3]{op,req_id,title,statement,from,to,name}:
  add_requirement,r12,Schema description convention,"所有 Zod schema 的人读描述 MUST 通过统一的 desc() helper（packages/shared/src/schemas/i18n.ts）定义。描述 MUST 使用中文（zh-CN）。config.ts 中的配置 schema MUST 使用 .describe(desc(...))。packages/shared/src/schemas/ 中的 API schema MUST 使用 .openapi({ description: desc(...) })。MUST NOT 在 .describe() 或 .openapi() 中直接硬编码字符串。",null,null,null
  add_requirement,r13,i18n extensibility,"desc() helper MUST 提供 i18n 就绪的签名：desc(zh: string, _key?: string): string。当前实现返回 zh 原文。未来切换 i18n 后端（typesafe-i18n / i18next / Lingui）时 MUST 只需修改 i18n.ts 文件，所有调用点无须变更。AGENTS.md MUST 记录此约定作为架构决策。",null,null,null
  add_requirement,r14,OpenAPI example metadata,"API schema 中用作 OpenAPI 端点请求体/响应体字段的 Zod schema，除 description 外 MAY 通过 .openapi() 附加 example 值。但不强制要求 — 优先保证所有字段有 description。OpenAPI tags 保持现有 feature-level 分组（notebooks、sessions、sources 等），MUST NOT 新增细粒度 tag。",null,null,null
op_scenarios[4]{req_id,id,given,when,then}:
  r12,config_desc,AiSettingsSchema 的 timeout 字段使用了 .describe(desc('AI 调用超时（秒）')),"运行 gen-app-schema",config/app.schema.gen.json 中 ai.properties.timeout.description 包含中文描述
  r12,api_desc,"NotebookSchema 的 name 字段使用了 .openapi({ description: desc('笔记本名称') })",访问 GET /openapi.json,"OpenAPI 中 notebooks 端点的 name 字段包含 description: '笔记本名称'"
  r13,i18n_ready,"某字段使用 desc('超时秒数', 'ai.timeout') 定义",当前实现,desc() 返回 '超时秒数'（zh 参数），_key 被忽略
  r14,openapi_example,"output schema 的 type 字段为 z.enum(['FAQ','GUIDE',...])","使用 .openapi({ description: desc('输出类型'), example: 'FAQ' })",OpenAPI 中 type 字段包含 description 和 example
