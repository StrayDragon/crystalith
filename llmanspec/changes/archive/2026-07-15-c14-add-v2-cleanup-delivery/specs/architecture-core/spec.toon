kind: llman.sdd.delta
ops[4]{op,req_id,title,statement,from,to,name}:
  add_requirement,r1,"v1 Python code fully removed","v2 发布时 MUST 删除 backend/py/ 全部内容。v1 历史 MUST 通过 git history 可追溯。",null,null,null
  add_requirement,r2,"OpenAPI generation chain removed","apps/web/openapi.gen.json 和 apps/web/src/api/generated/ MUST 删除。前端 MUST 完全使用 Elysia eden RPC 调用 server API。",null,null,null
  add_requirement,r3,"UPGRADES removed after specfication","UPGRADES/ 目录 MUST 删除。所有决策和调研结论 MUST 已固化到 llmanspec/changes/ 和 llmanspec/specs/。",null,null,null
  add_requirement,r4,"v2.0.0 tag and all behaviors verified","git tag v2.0.0 MUST 在以下条件满足后打上：所有 94 v1 端点有 v2 对应实现、Eval 回归检测全量通过、bun build --compile 三平台成功。",null,null,null
op_scenarios[4]{req_id,id,given,when,then}:
  r1,happy,"","git log -- backend/py/ 无最近 commit","仓库不包含 Python 代码"
  r2,happy,"","前端编译通过且无 openapi-ts 引用","所有 API 调用走 eden RPC"
  r3,happy,"","UPGRADES/ 目录不存在","v2 决策可在 llmanspec 中查阅"
  r4,happy,"","git tag v2.0.0 推送","Release 包含三平台二进制"
