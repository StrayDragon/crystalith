kind: llman.sdd.delta
ops[4]{op,req_id,title,statement,from,to,name}:
  add_requirement,r430,"Eden openReport navigates to real report page","Eden 模式下 Lab MUST NOT 以 toast 代替报告页；用户触发 openReport（顶栏、抽屉或等价 CTA）时 MUST 导航至 /research-lab/:nid/report 并携带当前 Run 的 ?rid= query；MUST NOT 调用 fixture ensureDefaultRevision 作为 Eden 默认路径。",null,null,null
  add_requirement,r431,"LabReportPage loads Run report as SSOT","Eden 模式下的 LabReportPage MUST 通过 GET …/research/:rid 加载 ResearchRun.report 作为报告正文与 citations 的权威源；MUST 渲染结构化 sections；MUST NOT 以 labRevisions 或 sessionStorage 作为 Eden 默认权威。",null,null,null
  add_requirement,r432,"Eden report uses CitationsControl adapter","Eden 报告面 MUST 将 ResearchReport.citations 经 adapter 复用 CitationsControl 展示引用（对齐 r408）；MUST NOT 为 Eden 报告另建平行引用弹层。",null,null,null
  add_requirement,r433,"Eden export reads Run report not stub toast","Eden 模式下 exportSuggestedFromGraph（或等价「从图导出建议报告」）MUST 从当前 Run 的 report 或等价结构化数据生成导出；MUST NOT toast「Eden 报告导出待接」；无 report 时 MUST 展示可见错误。",null,null,null
op_scenarios[8]{req_id,id,given,when,then,feature}:
  r430,"eden-open-report-no-stub-toast",Eden Lab 已加载 completed Run 且 report 存在,用户点「打开独立报告页」,导航至 /research-lab/:nid/report?rid= 且无 stub toast,true
  r430,"completed-cta-opens-report",Run status 为 completed 且 reportVisible,用户点顶栏查看报告,进入 Eden 报告页而非 toast,true
  r431,"report-page-loads-run-report",报告页以 eden 模式打开且 rid 有效,页面加载完成,展示 GET run 返回的 report 标题与章节,true
  r431,"eden-report-not-sessionstorage",Eden 报告页打开,sessionStorage 无 labRevisions,仍以 Run.report 渲染正文,true
  r432,"eden-citations-control",Eden 报告含 citation map,用户打开引用入口,CitationsControl 展示适配后的引用,true
  r433,"eden-export-from-report",Eden Run 已有 report,用户触发从图导出,生成 markdown 且无「待接」toast,true
  r433,"eden-export-no-report-error",Eden Run 无 report,用户触发导出,可见错误提示且无 fixture revision 写入,true
  r431,"report-rid-query-required",用户从 graph 页 ?rid= 打开报告,导航完成,报告页读取同一 rid 的 Run,true
