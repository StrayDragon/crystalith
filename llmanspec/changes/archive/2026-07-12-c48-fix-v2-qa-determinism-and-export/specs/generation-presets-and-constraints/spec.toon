kind: llman.sdd.delta
ops[3]{op,req_id,title,statement,from,to,name}:
  add_requirement,qa-stats-preset-must-exist,"QA MUST support the stats preset with chart/table structured output","QA MUST 支持 stats preset（与 v1 presets.py:93-99 一致）：包含 STATS_SYSTEM_PROMPT、StatsChart/StatsTable schema、专用生成 + JSON 解析路径（v1 api.py:289-304 与 457-504），当前 v2 presets.ts 仅 default/analysis/creative/explainer 而缺 stats",null,null,null
  add_requirement,qa-contextstats-must-use-real-tokens,"QA ContextStats MUST use real token counts and compression flag","QA 的 ContextStats 字段（total_tokens/system_tokens/history_tokens/retrieval_tokens/query_tokens/max_tokens/compressed）MUST 使用真实 token 计数（v1 用 TokenCounter，service.py:254-271），MUST NOT 用字符数估算（当前 retrieve-and-judge.ts:118 与 244-252 用 Math.ceil(length/4)）；compressed 标志 SHALL 在历史被截断/摘要时为 true（当前硬编码 false）",null,null,null
  add_requirement,qa-export-must-match-v1-citation-and-sources-shape,"QA export MUST match v1 citation line format and sources meta shape","QA export（markdown/json）MUST 与 v1 对齐：(1) markdown citation 行 SHALL 包含 page_number/paragraph_index（v1 api.py:599-610 _format_citation_line）；当前 router.ts:391-398 仅含 chunk_index。(2) JSON sources meta SHALL 为 source_id/source_name/mime_type/parser_type 且 notebook-scoped 且含 cited-but-deleted fallback（v1 api.py:89-94 与 584-595）；当前 router.ts:370-374 返回 id/filename/status。(3) JSON SHALL 含顶层 notebook_id（v1 api.py:679）；当前缺失。markdown SHALL 含 - Notebook ID 行",null,null,null
op_scenarios[3]{req_id,id,given,when,then}:
  qa-stats-preset-must-exist,stats-preset-request,"客户端请求 preset=stats","系统执行 QA 生成","系统 SHALL 使用 STATS_SYSTEM_PROMPT 并产出 StatsChart/StatsTable 结构化 JSON（与 v1 api.py:457-504 一致）"
  qa-contextstats-must-use-real-tokens,contextstats-compression,"历史消息累积超过 max_tokens","系统构造 QA 上下文","ContextStats.compressed SHALL 为 true（如 v1 触发历史压缩）；token 数值 SHALL 来自真实 token 计数"
  qa-export-must-match-v1-citation-and-sources-shape,export-markdown-citations,"用户导出 QA 会话为 markdown","系统生成 export","citation 行 SHALL 含 page/para 信息；JSON sources SHALL 含 mime_type/parser_type 且 notebook-scoped"
