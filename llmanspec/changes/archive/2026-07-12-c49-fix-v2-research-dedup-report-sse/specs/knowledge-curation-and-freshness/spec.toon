kind: llman.sdd.delta
ops[5]{op,req_id,title,statement,from,to,name}:
  add_requirement,research-dedup-must-be-cross-iteration,"Research dedup MUST seed seen-set from all accumulated results across iterations","research 搜索结果去重 MUST 跨迭代累积：去重 seen-set（seen_titles/seen_normalized_urls）SHALL 用 state.all_results（所有先前迭代累积结果）初始化，而非仅当前批次；当前 agent.ts:161 与 178 只对单批 allResults 去重，与 v1 graph.py:518 与 551 的跨迭代去重不一致，导致同一 URL/title 在迭代 2 后重复出现",null,null,null
  add_requirement,research-report-prompt-must-be-consistent,"Research report generation MUST use the v1 6-section prompt on BOTH paths","research report 生成 MUST 在所有路径使用 v1 的 6 段结构化 REPORT_SYSTEM_PROMPT（graph.py:94-128：Executive Summary/Background/Key Findings/Analysis/Recommendations/References）。当前 v2 仅 finish 路径（generateFinalReport, agent.ts:549-583）用该 prompt；正常完成路径（generateReport, agent.ts:296-304）用 1 行极简 prompt 'You are a research report writer. Produce a comprehensive markdown report.'，与 c46 承诺的 report 富 prompt 仅半数兑现",null,null,null
  add_requirement,research-sse-must-emit-status-and-thinking,"Research SSE MUST emit status events and rich thinking payloads like v1","research SSE 事件流 MUST 对齐 v1 覆盖度：(1) SHALL 在每次状态转换时发 status 事件（v1 api.py:1037-1058）；当前 v2 完全不发 status。(2) SHALL 发富 thinking 事件（状态消息 api.py:1044-1050、迭代变更 1060-1071、每步 reasoning/insight/decision 1102-1186）；当前 v2 把非 plan/search/analyze/summary 步骤塌缩成无消息的 thinking（router.ts:783-785）。前端依赖 status/thinking 维护 UI 状态时会回归",null,null,null
  add_requirement,research-resume-must-restore-plan,"Research resume MUST restore the in-flight search plan and start node","research resume（runResearchFromState）MUST 还原暂停时的 search_plan 与起始节点：(1) SHALL 从持久化 steps 还原 search_plan（v1 _extract_plan_from_steps, graph.py:945-972 与 1009）；当前 agent.ts:502-526 只还原 iteration+results，总是重新 planSearches。(2) SHALL 支持 start-node 选择（v1 _start_node_for_status, graph.py:1013-1028）使 waiting_user/searching 状态跳过重规划直接进入 WaitForApproval/ExecuteSearches。否则 resume 一个 waiting_user 会话会重新生成 plan 而非展示用户即将审批的那个",null,null,null
  add_requirement,research-export-note-must-use-structured-type,"Research export note MUST use STRUCTURED output type with v1 content schema","research export 的 note 类型 MUST 用 OutputType=STRUCTURED + content={title, text, metadata}（v1 api.py:1434-1448），MUST NOT 用 BRIEFING + {title, sections:[{heading, points}]}（当前 router.ts:606-611）。两者 type 与 content schema 均不兼容，跨版本不可比",null,null,null
op_scenarios[5]{req_id,id,given,when,then}:
  research-dedup-must-be-cross-iteration,cross-iter-dedup,"迭代 1 已返回某 URL 的结果","迭代 2 再次返回同一 URL","该 URL SHALL 被去重（与 v1 一致），不重复进入 all_results"
  research-report-prompt-must-be-consistent,normal-completion-report,"research agent 自然完成最大迭代","系统生成 report","report SHALL 使用 6 段结构化 prompt（与 finish 路径一致），非 1 行极简 prompt"
  research-sse-must-emit-status-and-thinking,sse-status-event,"research 状态从 planning 转 waiting_user","SSE 流推送事件","SHALL 发 status 事件；前端 SHALL 能据 status 更新 UI 状态"
  research-resume-must-restore-plan,resume-with-plan,"session 处 waiting_user 且有未审批 plan","客户端触发 resume","SHALL 展示原 plan（而非重新生成）；SHALL 跳过重规划直接进入 WaitForApproval"
  research-export-note-must-use-structured-type,export-note,"用户导出 research 为 note 类型","系统创建 Output","Output.type SHALL 为 STRUCTURED + content={title,text,metadata}（与 v1 一致）"
