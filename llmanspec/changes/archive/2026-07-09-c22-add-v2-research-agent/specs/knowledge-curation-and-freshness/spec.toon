kind: llman.sdd.delta
ops[4]{op,req_id,title,statement,from,to,name}:
  add_requirement,r7,"Research agent runs multi-round state machine","Research agent MUST 运行多轮状态机（PlanSearches→WaitForApproval→ExecuteSearches→AnalyzeResults→GenerateReport）。循环条件 MUST 为 need_more_search AND current_iteration < max_iterations(默认4)。MUST 写 researchSteps 表。MUST NOT 单次 streamText 无迭代。",null,null,null
  add_requirement,r8,"Research SSE streams DB-polling progress","Research MUST 提供 GET /research/:id/stream DB-polling SSE（1s 间隔/30s heartbeat/最长1h）。事件 MUST 含 plan_ready/search_progress/analysis/thinking/report/done。MUST 派生自 researchSteps 差分。",null,null,null
  add_requirement,r9,"Research HITL gates via real approval flow","Research approve/modify/skip/finish/cancel/resume MUST 经 DB 轮询 WaitForApproval 门控。MUST 写 researchStep(USER_INPUT)。cancel MUST 通过 AbortController 真中断运行中 agent，MUST NOT 仅改 status。",null,null,null
  add_requirement,r10,"Research lock prevents concurrent runs","Research session MUST 用 locked_at/lock_expires_at 锁防止并发（LOCK_TIMEOUT=600s）。MUST 周期续期（每 300s）。过期锁 MUST 被清理并 cancel session。",null,null,null
op_scenarios[4]{req_id,id,given,when,then}:
  r7,happy,"maxIterations=4，AnalyzeResults 返回 need_more=true","迭代","PlanSearches→Execute→Analyze 循环，直到 need_more=false 或 iter=4"
  r8,happy,"research 运行中，前端连 SSE","GET /stream","每秒派生 researchSteps 差分事件，30s 一次 heartbeat，terminal 时 done"
  r9,happy,"agent running 中，用户 cancel","POST /cancel","AbortController.abort() 中断，status=CANCELLED，GenerateReport 不执行"
  r10,happy,"同 session 已有活跃锁","再次启动","拒绝并发（锁未过期），或过期锁被清理后 cancel"
