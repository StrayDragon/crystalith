kind: llman.sdd.delta
ops[4]{op,req_id,title,statement,from,to,name}:
  add_requirement,r426,"Lab exposes cancel for active Eden runs","Eden 模式下当 ResearchRun status 为 queued、running 或 awaiting_confirm 时，Lab MUST 暴露取消入口（顶栏主/次操作和/或任务抽屉行操作）；用户触发后 MUST 调用 POST …/research/:rid/cancel；成功或 SSE 终态后 Run status MUST 变为 cancelled，且 MUST 按 r425 立即 refresh 任务 inbox；completed、failed、cancelled MUST NOT 再提供取消。",null,null,null
  add_requirement,r427,"Eden primary action maps to cancel not fixture pause","Eden 模式下顶栏主操作 MUST 与 ResearchRun 生命周期对齐：queued 或 running 时主操作 MUST 映射协作 cancel（MUST NOT 调用 fixture pause 空操作）；awaiting_confirm 时 MUST 保持「生成结论」主操作与「继续深挖」次操作；cancel 成功后 UI MUST 展示 cancelled 终态说明。",null,null,null
  add_requirement,r428,"Compose copy switches by eden or fixture mode","LabComposePanel MUST 按 mode（eden 或 fixture）切换说明文案与底部 hint；eden 模式 MUST NOT 将 xlsx fixture、演示回放或「接线后将创建」表述为权威或默认路径；fixture 模式 MAY 保留 fixture 演示说明。",null,null,null
  add_requirement,r429,"Eden example topic avoids fixture-only wording","Eden 模式下「填入示例主题」控件 MUST 使用中性文案或隐藏 fixture 专属措辞（如 xlsx 选型）；fixture 模式 MAY 保留 xlsx-lib 示例主题按钮与文案。",null,null,null
op_scenarios[8]{req_id,id,given,when,then,feature}:
  r426,"cancel-from-header-running",Eden Lab 已打开且 Run status 为 running,用户点顶栏取消并确认,POST cancel 成功且 Run 变为 cancelled,true
  r426,"cancel-from-drawer-awaiting-confirm",任务抽屉有一项 awaiting_confirm,用户从抽屉触发取消,cancel 成功且列表 status 为 cancelled,true
  r426,"cancel-refreshes-inbox",c84 inbox refresh 已接线,Eden cancel 成功,任务列表经 refresh 反映 cancelled 且 badge 不计入进行中,true
  r427,"running-primary-is-cancel",Eden Run 为 running 且顶栏展示主操作,用户查看主按钮标签与行为,映射 cancel 而非空 pause,true
  r427,"awaiting-confirm-keeps-finish-dig",Eden Run 为 awaiting_confirm,用户查看顶栏,主操作为生成结论且次操作为继续深挖,true
  r428,"eden-compose-no-fixture-authority",Lab Compose 以 eden 模式打开,用户阅读说明与 hint,文案不提 xlsx fixture 或演示回放为权威,true
  r428,"fixture-compose-keeps-demo-copy",Lab Compose 以 fixture 模式打开,用户阅读说明,MAY 保留 fixture 演示回放说明,true
  r429,"eden-example-topic-neutral",Lab Compose 为 eden 模式,用户查看示例主题按钮,文案为中性且无 xlsx 选型专属措辞,true
