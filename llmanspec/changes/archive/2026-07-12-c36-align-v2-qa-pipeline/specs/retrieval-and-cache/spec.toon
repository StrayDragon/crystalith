kind: llman.sdd.delta
ops[1]{op,req_id,title,statement,from,to,name}:
  add_requirement,qa-source-scoping,"QA retrieval MUST support source_ids filtering","QA 检索路径 MUST 支持通过 source_ids 参数将检索范围限定到指定 source 子集，并支持可配置的 min_score 阈值作为证据门控",null,null,null
op_scenarios[1]{req_id,id,given,when,then}:
  qa-source-scoping,scoped-retrieval,"notebook 有 3 个 source","用户指定 source_ids=[1,2] 提问","系统 SHALL 仅在 source 1 和 2 的 chunk 范围内检索"
