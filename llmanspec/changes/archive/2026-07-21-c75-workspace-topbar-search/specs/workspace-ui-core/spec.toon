kind: llman.sdd.delta
ops[3]{op,req_id,title,statement,from,to,name}:
  modify_requirement,r116,"Header remains compact and hosts search entry","顶部栏 MUST 提供 notebook 切换、布局锁定、全局入口，并 MUST 在中间区域提供统一的搜索/调研输入入口；窄屏下关键入口仍可访问。",null,null,null
  add_requirement,"workspace-topbar-e1-search-panel","Top bar MUST open E1 anchored search panel","用户点击或聚焦顶栏搜索/调研输入时，Workspace MUST 打开锚定于顶栏的宽幅面板（E1）：面板层级与关闭策略 MUST 走统一 Layer（Esc 与遮罩可关闭）；MUST NOT 使用硬编码 z-index。",null,null,null
  add_requirement,"workspace-topbar-panel-tabs","E1 panel MUST expose Fast Search and Deep Research tabs","顶栏 E1 面板 MUST 至少提供「快速搜索」与「深度研究」两个 Tab；「快速搜索」MUST 为默认可用的网搜添来源路径；「深度研究」Tab 在本阶段可为壳，但 MUST 可发现。",null,null,null
op_scenarios[4]{req_id,id,given,when,then,feature}:
  r116,"topbar-shows-search-entry","","用户进入 Workspace 桌面布局",系统 SHALL 在顶部栏中间区域展示可点击的搜索/调研输入入口,false
  "workspace-topbar-e1-search-panel","click-opens-anchored-panel","","用户点击顶栏搜索输入",系统 SHALL 打开锚定顶栏的宽幅面板且可用 Esc 或遮罩关闭,false
  "workspace-topbar-panel-tabs","default-tab-is-fast-search","","用户打开 E1 面板",系统 SHALL 展示快速搜索与深度研究 Tab，且快速搜索可用于发起网搜,false
  "workspace-topbar-panel-tabs","deep-research-tab-visible","","用户打开 E1 面板并切换到深度研究",系统 SHALL 展示深度研究 Tab 内容（可为重建中壳），且不得因缺 Runtime 而整页崩溃,false
