kind: llman.sdd.delta
ops[4]{op,req_id,title,statement,from,to,name}:
  add_requirement,"sources-panel-must-not-host-primary-web-search","Sources panel MUST NOT host primary web search","来源面板 MUST NOT 再承载用于「在网络中搜索新来源」的主搜索条，也 MUST NOT 再以 Deep/Fast 模式切换作为网搜/深研主入口；来源面板 MUST 专注库管理（添加 URL/上传/连接器/列表）。若保留本地过滤，placeholder MUST 表达筛选已有来源而非网搜。",null,null,null
  add_requirement,"topbar-fast-search-reuses-web-ingest","Fast Search tab MUST reuse existing web search and ingest","E1「快速搜索」Tab MUST 使用与迁出前一致的网搜 API（SearXNG）与添加到来源的 ingest 路径；前端 MUST NOT 复制第二套独立的 SearXNG fetch 实现。失败与空结果 MUST 有明确用户可见反馈。",null,null,null
  add_requirement,"deep-research-tab-is-shell-until-runtime","Deep Research tab MUST be a non-agent shell","E1「深度研究」Tab 在本变更范围内 MUST 仅提供壳（空队列/重建提示或禁用开始）；MUST NOT 调用已删除或 stub 的 Deep Research agent 编排逻辑；MUST NOT 假装任务已在运行。",null,null,null
  modify_requirement,r59,"Panel composition stays stable with topbar research entry","Workspace MUST 以稳定的面板集合装配 Sources/Chat/Studio 等能力，并保持各面板的基本区域划分与入口可发现；网搜添来源与深研入口 MUST 经由顶栏 E1 面板发现，而非嵌在来源栏主搜索条。",null,null,null
op_scenarios[5]{req_id,id,given,when,then,feature}:
  "sources-panel-must-not-host-primary-web-search","sources-has-no-primary-web-search","","用户查看来源面板",界面 SHALL 不展示「在网络中搜索新来源」主搜索条，也不展示 Deep/Fast 网搜模式切换作为主入口,false
  "topbar-fast-search-reuses-web-ingest","fast-search-can-add-source",顶栏 E1 快速搜索 Tab 已打开,用户提交网搜查询并选择结果添加到笔记本,系统 SHALL 走现有网搜与 ingest 路径将来源加入当前 notebook,false
  "topbar-fast-search-reuses-web-ingest","searxng-error-is-visible",SearXNG 不可用或网搜失败,用户在快速搜索 Tab 发起查询,系统 SHALL 展示明确错误/降级提示且不静默空成功,false
  "deep-research-tab-is-shell-until-runtime","shell-does-not-start-agent","","用户打开深度研究 Tab 并尝试开始",系统 SHALL 不启动 Deep Research agent；SHALL 展示壳态或禁用/提示重建中,false
  r59,"research-entry-via-topbar","","用户需要网搜或深研入口",系统 SHALL 通过顶栏 E1 面板提供可发现入口，而不是依赖来源栏主搜索条,false
