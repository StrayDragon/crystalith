kind: llman.sdd.delta
ops[5]{op,req_id,title,statement,from,to,name}:
  add_requirement,research-resume-infer-state,"Resume MUST infer state from persisted steps","research resume 端点 MUST 通过检查已持久化的 steps 推断恢复状态和迭代号，而非强制从头重跑",null,null,null
  add_requirement,research-control-actions-record-steps,"Control endpoints MUST record steps and resume","research 的 approve/modify/skip/finish/cancel 端点 MUST 记录对应的 user_input step 并确保后台 resume",null,null,null
  add_requirement,research-finish-generates-report,"Finish MUST trigger report generation","research finish 端点 MUST 在标记 COMPLETED 后触发最终报告生成并持久化",null,null,null
  add_requirement,research-delete-endpoint,"API MUST provide research delete endpoint","系统 MUST 提供 research 删除端点，在删除前取消运行中的研究",null,null,null
  add_requirement,research-sse-named-events,"Research SSE MUST emit named events","research 流式端点 MUST 发送带 event: 字段的命名 SSE 事件",null,null,null
op_scenarios[5]{req_id,id,given,when,then}:
  research-resume-infer-state,resume-after-search,"研究在第 2 轮搜索后中断","用户调 resume","系统 SHALL 推断 SEARCHING 状态和 iteration=2，从断点恢复而非重跑"
  research-control-actions-record-steps,skip-action,"研究在 WAITING_USER 等待用户决策","用户调 skip","系统 SHALL 记录 skip step 并推进 iteration 然后恢复"
  research-finish-generates-report,finish-with-results,"研究积累了多轮搜索结果","用户调 finish","系统 SHALL 生成最终报告并存入 finalReport 字段"
  research-delete-endpoint,delete-running,"研究正在运行","用户调 delete","系统 SHALL 先取消运行中的研究再删除记录"
  research-sse-named-events,plan-ready-event,"研究生成了搜索计划","SSE 流发出 plan_ready","事件 SHALL 包含 event: plan_ready 行"
