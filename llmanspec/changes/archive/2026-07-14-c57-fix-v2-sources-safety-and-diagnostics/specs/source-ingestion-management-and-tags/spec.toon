kind: llman.sdd.delta
ops[4]{op,req_id,title,statement,from,to,name}:
  add_requirement,"single-source-routes-must-verify-notebook-ownership","Single source routes MUST verify notebook ownership","单 source 操作路由（GET 单个 / DELETE / re-embed / chunks）MUST 校验目标 source 属于路径或 query 中的 notebook（`source.notebookId === notebook_id`）。归属不匹配时 MUST 返回 404（不得泄露 source 存在性）。MUST NOT 允许跨 notebook 访问。",null,null,null
  add_requirement,"batch-ops-must-return-per-item-results","Batch operations MUST return per-item results array","批量 re-embed 与批量 delete 响应 MUST 包含 `results: SourceBatchItemResult[]` 数组，每项含 `{source_id, ok, error_code?, message?}`。缺失的 source 标 `{ok:false, error_code:'SOURCE_NOT_FOUND'}`。MUST NOT 只返回 id 列表而省略 per-item 诊断。",null,null,null
  add_requirement,"tag-changes-must-invalidate-sources-cache","Tag changes MUST invalidate sources cache","Tag CRUD（create / update / delete）与 bind / unbind 操作完成后 MUST 递增该 notebook 的 sources_epoch 以失效 sources 列表缓存。MUST NOT 在 tag 变更后仍返回陈旧的 sources 列表（因 list-sources 缓存键含 tag 过滤）。",null,null,null
  add_requirement,"reembed-must-clear-all-error-fields","Re-embed MUST clear all error fields","Re-embed（单 source 与 batch）重置 status 为 processing 时 MUST 清除全部错误字段：errorCode / errorMessage / recoveryHint / lastErrorAt 均置 null。MUST NOT 残留陈旧错误码导致 UI 误显示失败状态。",null,null,null
op_scenarios[6]{req_id,id,given,when,then}:
  "single-source-routes-must-verify-notebook-ownership","cross-notebook-access-denied","a source belongs to notebook A","a caller accesses it via notebook B's scoped route","the system MUST return 404 (not the source data)"
  "single-source-routes-must-verify-notebook-ownership","same-notebook-access-granted","a source belongs to notebook A","a caller accesses it via notebook A's scoped route","the system MUST return the source data normally"
  "batch-ops-must-return-per-item-results","batch-reembed-results","a batch re-embed is requested for 3 sources where 1 is missing","the system processes the batch","the response MUST include a results array with 3 entries including the missing one marked {ok:false, error_code:'SOURCE_NOT_FOUND'}"
  "batch-ops-must-return-per-item-results","batch-delete-results","a batch delete is requested for 3 sources where 1 is missing","the system processes the batch","the response MUST include a results array with per-item status"
  "tag-changes-must-invalidate-sources-cache","tag-create-bumps-epoch","a notebook has a sources list cache entry","a tag is created in that notebook","the sources_epoch MUST increment causing the next list query to bypass cache"
  "reembed-must-clear-all-error-fields","reembed-clears-stale-code","a source has errorCode='EMBEDDING_FAILED' and recoveryHint set","the source is re-embedded","after status set to processing all four error fields MUST be null"
