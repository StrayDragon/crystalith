kind: llman.sdd.delta
ops[5]{op,req_id,title,statement,from,to,name}:
  add_requirement,r1,"RAGStrategy interface is pluggable","每种 RAG 策略 MUST 实现 RAGStrategy 接口：id/name/description/version + index(sources) + retrieve(query) + isIndexed(notebookId)。",null,null,null
  add_requirement,r2,"RAGRegistry manages strategy lifecycle","RAGRegistry MUST 提供 register/get/list/apply 方法。每个 notebook MUST 可通过 strategy_configs 表配置启用哪些策略。",null,null,null
  add_requirement,r3,"Keyword RAG uses sqlite-fts5 BM25","Keyword RAG 策略 MUST 使用 sqlite-fts5 全文索引实现 BM25 检索。MUST 与 Embed 策略共享 chunks 表数据。",null,null,null
  add_requirement,r4,"Hybrid retrieval fuses Embed + BM25 via RRF","混合检索 MUST 并行执行 Embed 和 BM25 检索，结果通过 Reciprocal Rank Fusion (RRF) 融合排序。MUST 支持权重可配。",null,null,null
  add_requirement,r5,"Page Index strategy indexes by page","Page Index 策略 MUST 按 PDF 页面为粒度建立索引，检索时返回整页 chunks + 页面预览。",null,null,null
op_scenarios[5]{req_id,id,given,when,then}:
  r1,happy,"","开发者实现新的 GraphRAGStrategy","register 后可通过 /v2/strategies 列出"
  r2,happy,"","用户在 notebook 设置启用 Embed + BM25","apply 后两个策略同时 index，查询时并行检索"
  r3,happy,"","10k chunk BM25 检索","p50 < 5ms，返回 title/snippet 匹配结果"
  r4,happy,"","Embed 返回 top-5，BM25 返回 top-5","RRF 融合后产出 top-10，排序合理"
  r5,happy,"","PDF 100 页","Page Index 建立 100 条页面级索引，检索返回页面预览"
