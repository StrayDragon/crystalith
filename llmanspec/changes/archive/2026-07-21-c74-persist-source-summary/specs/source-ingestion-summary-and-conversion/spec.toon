kind: llman.sdd.delta
ops[3]{op,req_id,title,statement,from,to,name}:
  modify_requirement,r49,"Source summary is cache-first with explicit regenerate",来源摘要 GET MUST 仅允许 ready 来源且 MUST NOT 调用 LLM：有 metadata.autoSummary 则返回缓存；无缓存时 MUST 返回 200 空态（空 summary/要点/主题，generatedAt 可空）。摘要的生成与覆盖 MUST 仅由 POST 同 path（或 ingest ready 后的异步预生成）完成并写入 metadata.autoSummary。,null,null,null
  add_requirement,"summary-post-persists-auto-summary",POST summary MUST persist autoSummary,"POST /v2/notebooks/:nid/sources/:sid/summary MUST 对 ready 来源生成摘要结构，MUST 将结果 merge 写入 sources.metadata.autoSummary，并 MUST 返回与有缓存时 GET 相同形状的 SourceSummary。",null,null,null
  add_requirement,"summary-async-after-ready","Ingest MUST async-pregenerate summary after ready",来源 ingest 成功标记 ready 后，系统 SHOULD 异步预生成并写入 metadata.autoSummary；预生成失败 MUST NOT 将 source 标为 failed，也 MUST NOT 阻塞 ingest 成功响应。,null,null,null
op_scenarios[4]{req_id,id,given,when,then,feature}:
  r49,"get-returns-cache-without-llm",ready 来源已有 metadata.autoSummary,客户端 GET summary,系统 SHALL 返回缓存内容且不调用聊天模型,false
  r49,"get-empty-when-missing",ready 来源尚无 autoSummary,客户端 GET summary,系统 SHALL 返回 200 空态且不调用聊天模型,false
  "summary-post-persists-auto-summary","post-writes-metadata",ready 来源无或已有 autoSummary,客户端 POST summary,系统 SHALL 生成并写入 metadata.autoSummary 且响应含完整摘要字段,false
  "summary-async-after-ready","ready-triggers-async-summary",文件 ingest 即将完成,source 被标记为 ready,系统 SHALL 在不阻塞响应的前提下尝试异步写入 autoSummary；失败不改 status,false
