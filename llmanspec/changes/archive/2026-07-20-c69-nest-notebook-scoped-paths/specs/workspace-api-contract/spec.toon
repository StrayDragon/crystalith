kind: llman.sdd.delta
ops[4]{op,req_id,title,statement,from,to,name}:
  add_requirement,"notebook-scoped-resources-use-nested-paths","Notebook-scoped resources MUST use nested paths","notebook 作用域资源（至少包括 outputs CRUD、research、qa（含 stream/export）、refine（不含 modes）、studio/slides、sources 单资源与 upload）的 canonical HTTP path MUST 为 /v2/notebooks/:nid/<domain>/...。path 中的 :nid MUST 作为 notebook 归属边界；跨 notebook 访问 MUST 返回 404。",null,null,null
  add_requirement,"flat-notebook-scoped-paths-are-deprecated-aliases","Flat notebook-scoped paths MUST be deprecated aliases","在嵌套路径落地后，旧扁平路径（如 /v2/outputs、/v2/research、/v2/qa）MUST 仅作为 deprecated alias 存在（或在明确窗口后移除）。alias MUST 保留 c67 归属校验语义（query/body notebookId 必填）。一等前端 MUST 改用嵌套路径；文档 MUST 标注旧路径为 deprecated。",null,null,null
  add_requirement,"process-registries-remain-global-flat","Process registry endpoints MUST remain global flat","进程级 registry 端点 MUST 保持全局扁平且 MUST NOT 嵌套到 /v2/notebooks/:nid/...：至少包括 GET /v2/outputs/types、GET /v2/qa/presets、GET /v2/refine/modes、GET /v2/sources/parsers。另：notebooks 列表、models、commands、prompt-presets、templates、eval、strategies MUST 保持扁平。",null,null,null
  add_requirement,"nested-path-nid-is-ownership-ssot","Nested path :nid is ownership SSOT","嵌套 canonical 路由上，path :nid MUST 为归属唯一真源；请求 body MUST NOT 再要求必填 notebookId。若 body 携带 notebookId：等于 :nid 时 MUST 忽略；不等于时 MUST 返回 400。响应实体 MAY/SHOULD 继续包含 notebookId 字段。扁平 alias 不受本条约束（仍走 c67 query/body）。",null,null,null
op_scenarios[6]{req_id,id,given,when,then,feature}:
  "notebook-scoped-resources-use-nested-paths","nested-outputs-list","存在 notebook N 与若干 outputs","客户端调用 GET /v2/notebooks/N/outputs","响应 SHALL 成功列出该 notebook 的 outputs",false
  "notebook-scoped-resources-use-nested-paths","nested-cross-notebook-404","output 属于 notebook A","客户端以 notebook B 调用 GET /v2/notebooks/B/outputs/:id","响应 SHALL 为 404",false
  "flat-notebook-scoped-paths-are-deprecated-aliases","flat-alias-still-works-while-deprecated","嵌套路径与扁平 alias 均已挂载","客户端仍调用旧扁平 /v2/outputs?notebookId=N","响应 SHALL 仍可用且文档/标注 SHALL 表明 deprecated",false
  "process-registries-remain-global-flat","outputs-types-stays-flat","系统已挂载嵌套 outputs","客户端调用 GET /v2/outputs/types","响应 SHALL 成功且 MUST NOT 要求 notebook 路径前缀",false
  "nested-path-nid-is-ownership-ssot","nested-post-without-body-notebook-id","存在 notebook N","客户端 POST /v2/notebooks/N/outputs 且 body 省略 notebookId","请求 SHALL 被接受（其余字段合法时）并以 N 为归属",false
  "nested-path-nid-is-ownership-ssot","nested-post-mismatched-body-notebook-id","存在 notebook N","客户端 POST /v2/notebooks/N/outputs 且 body.notebookId=M（M≠N）","响应 SHALL 为 400",false
