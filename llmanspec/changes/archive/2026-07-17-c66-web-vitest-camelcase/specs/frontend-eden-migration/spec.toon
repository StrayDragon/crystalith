kind: llman.sdd.delta
ops[2]{op,req_id,title,statement,from,to,name}:
  add_requirement,r287,"Web Vitest fixtures MUST use camelCase wire","apps/web Vitest/MSW 测试夹具与断言 MUST 使用 camelCase HTTP/SSE JSON 字段名（与 @crystalith/shared / Eden wire 一致）。MUST NOT 在测试 mock 中继续使用 notebook_id、source_ids、message_id 等 snake_case wire 键作为正式期望。",null,null,null
  modify_requirement,"frontend-sources-must-pass-notebook-id-query","Frontend sources single-item calls MUST pass notebookId query for ownership check","前端调用 sources 单 source 路由（GET /sources/:id、DELETE /sources/:id、POST /sources/:id/re-embed、GET /sources/:id/chunks）MUST 传递 `notebookId` query 参数以激活服务端归属校验。MUST NOT 省略此参数导致归属校验被跳过。notebookId 从 workspace store 的 activeNotebookId 获取。",null,null,null
op_scenarios[2]{req_id,id,given,when,then}:
  r287,vitest-camel-fixtures,"c65 wire 已为 camelCase","运行 apps/web vitest","SHALL 全绿且 mock/断言使用 camelCase 字段"
  "frontend-sources-must-pass-notebook-id-query",delete-passes-notebookId,"用户在 notebook A 删除来源","前端调用 DELETE /sources/:id","请求 MUST 包含 ?notebookId=A"
