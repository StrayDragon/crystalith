kind: llman.sdd.delta
ops[2]{op,req_id,title,statement,from,to,name}:
  add_requirement,session-get-single,"API MUST provide GET single session","系统 MUST 提供 GET 单个 session 端点返回完整 session 信息",null,null,null
  add_requirement,session-convert-citation-chunks,"Session convert-to-output MUST collect chunk_ids from citations","session convert-to-output MUST 从消息 citations 中收集 chunk_ids 并附加到创建的 output",null,null,null
op_scenarios[2]{req_id,id,given,when,then}:
  session-get-single,fetch-session,"一个 session 存在","客户端请求 GET 单个 session","系统 SHALL 返回该 session 的完整信息"
  session-convert-citation-chunks,convert-with-citations,"session 消息含 citations","convert-to-output 调用","系统 SHALL 从 citations 收集 chunk_ids 附加到 output"
