kind: llman.sdd.delta
ops[1]{op,req_id,title,statement,from,to,name}:
  modify_requirement,"openapi-documents-nested-canonical-paths","OpenAPI MUST document nested canonical paths","registerApiDoc 与 OpenAPI 文档 MUST 以嵌套 /v2/notebooks/:nid/... 为 notebook-scoped 资源的唯一文档真源。MUST NOT 再登记已删除的扁平 notebook-scoped alias（如 /v2/outputs、/v2/qa、/v2/studio/slides*、扁平 /v2/sources/:id）。进程级 registry（如 GET /v2/sources/parsers）MAY 保持扁平文档。",null,null,null
op_scenarios[2]{req_id,id,given,when,then,feature}:
  "openapi-documents-nested-canonical-paths","outputs-nested-in-docs","outputs 已挂载嵌套路径","检查 registerApiDoc / OpenAPI","文档 SHALL 含 /v2/notebooks/{nid}/outputs 且 MUST NOT 登记已删扁平 /v2/outputs 为可调用操作",false
  "openapi-documents-nested-canonical-paths","no-flat-alias-in-docs","flat notebook-scoped aliases 已从路由删除","检查 registerApiDoc / OpenAPI","文档 SHALL 含嵌套 /v2/notebooks/{nid}/outputs 等且 MUST NOT 再登记已删扁平 alias 为可调用操作",false
