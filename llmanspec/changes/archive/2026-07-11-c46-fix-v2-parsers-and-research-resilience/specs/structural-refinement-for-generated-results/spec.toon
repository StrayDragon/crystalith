kind: llman.sdd.delta
ops[4]{op,req_id,title,statement,from,to,name}:
  add_requirement,research-report-rich-prompt,"Research report MUST use structured 6-section prompt","research report 生成 MUST 使用 v1 结构化 REPORT_SYSTEM_PROMPT（Executive Summary/Background/Key Findings/Analysis/Recommendations/References 六段），MUST NOT 用一行通用 prompt",null,null,null
  add_requirement,research-ai-failure-fallback,"Research MUST have AI failure fallbacks for plan and analyze","research plan/analyze 失败时 MUST 有 fallback（plan→2-query fallback；analyze→coverage heuristic），MUST NOT 直接中止整个 run",null,null,null
  add_requirement,research-waiting-heartbeat,"Research SSE MUST emit waiting heartbeat while awaiting approval","research stream 在 status=waiting_user 时 MUST 定期重发 waiting 事件作为心跳，MUST NOT 只发一次",null,null,null
  add_requirement,research-lock-renewal,"Research MUST renew lock during long runs","research agent loop MUST 定期续期 lock，防止长任务（>10min）被 cleanupExpiredLocks 误杀",null,null,null
op_scenarios[4]{req_id,id,given,when,then}:
  research-report-rich-prompt,finish-generates-report,"客户端 finish research","report 生成","系统 SHALL 使用 6 段结构化 prompt 生成 report"
  research-ai-failure-fallback,plan-throws,"planSearches 抛出错误","agent loop","系统 SHALL 使用 fallback 2-query plan 继续而非中止 run"
  research-waiting-heartbeat,awaiting-approval,"status=waiting_user 持续中","stream poll loop","系统 SHALL 每次 poll 重发 waiting 事件"
  research-lock-renewal,long-running-iteration,"单次迭代超过 5min","agent loop","系统 SHALL 续期 lock 防止过期"
