kind: llman.sdd.delta
ops[4]{op,req_id,title,statement,from,to,name}:
  add_requirement,r1,"Research agent uses streamText + maxSteps=20","研究 agent MUST 使用 AI SDK streamText + maxSteps=20 实现多轮搜索→分析→综合循环。MUST 支持 webSearch、analyzeResults、writeReport 工具。",null,null,null
  add_requirement,r2,"Web search via SearXNG HTTP API","webSearch 工具 MUST 通过 fetch() 直接调用 SearXNG /search?q=...&format=json，解析 results 返回 title/url/snippet。MUST NOT 依赖 langchain。",null,null,null
  add_requirement,r3,"Research sessions support approval flow","研究流程 MUST 支持暂停等待用户审批。用户 MAY 审核中间结果后继续或终止。研究结果 MUST 持久化为 research_report。",null,null,null
  add_requirement,r4,"Research tasks run as background jobs","长期研究任务 MUST 作为后台 job 执行，前端可通过 /v2/tasks 查询进度。job 失败 MUST 记录错误并可重试。",null,null,null
op_scenarios[4]{req_id,id,given,when,then}:
  r1,happy,"","用户提交研究主题","agent 多轮搜索→分析→综合，生成研究报告"
  r2,happy,"","webSearch 查询 SearXNG","返回搜索结果 title/url/snippet 数组"
  r3,happy,"","agent 分析完成后暂停","前端显示结果摘要，用户点击'继续'或'终止'"
  r4,happy,"","研究需要 5 分钟","前端轮询 /v2/tasks/:id 显示进度，不阻塞 UI"
