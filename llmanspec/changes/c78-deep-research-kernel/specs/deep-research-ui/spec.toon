kind: llman.sdd.delta
ops[5]{op,req_id,title,statement,from,to,name}:
  add_requirement,r415,"Thin client command ports",Deep Research Desk（及正式接线后的 Lab 展示层）MUST 以 GET ResearchRun 与 SSE graph_patch/status/confirm 作为图与状态的展示权威；用户剪枝、分叉、确认、取消、转化、节点字段修改 MUST 仅调用对应 HTTP 命令口；客户端 MAY 做可丢弃的本地预览，但在命令响应或后续 graph_patch 到达后 MUST 以服务端结果为准回写；MUST NOT 将本地定时回放或伪造图作为生产 Run 的权威状态机。,null,null,null
  add_requirement,r416,"Role-preferring graph render",研究图 UI MUST 优先依据节点 role（question|research|conclusion）区分交互与保护态展示；当 role 缺失时 MUST 回退到既有 id 前缀或 merge 目标启发式以保持兼容；MUST NOT 因缺少精致视觉规格而阻塞命令口接线。,null,null,null
  add_requirement,r417,"Node chat UI wires proposals to commands",节点对话 UI MUST 消费独立 chat SSE 展示正文与提案；用户接受剪枝/分叉/改查询/定态/确认类提案时 MUST 调用对应 prune/fork/PATCH/confirm 命令口；MUST NOT 仅在本地改图作为权威；打开报告类动作可为纯前端导航。,null,null,null
  add_requirement,r418,"Desk canvas prefs from Lab mechanisms",Desk 研究图 MUST 提供与 Lab 对齐的画布机制入口（至少布局方向或算法偏好、以及小地图可开关之一档）；这些偏好 MAY 仅存于客户端；MUST NOT 因此新增服务端编排 API 或改变图 SSOT。,null,null,null
  add_requirement,r419,"Revisions UI over server snapshots",Desk（或报告面）MUST 能列出并查看服务端 revisions，并 MUST 支持创建当前快照与恢复到某 revision（经 API）；MUST NOT 继续以仅 sessionStorage 的 Lab CoW 作为生产权威版本源。,null,null,null
op_scenarios[5]{req_id,id,given,when,then,feature}:
  r415,"prune-uses-http-not-local-ssot","详情已订阅 SSE 且用户完成剪枝二次确认","客户端执行剪枝","发出 POST prune，并以返回 Run 或后续 graph_patch 更新画布，而非仅本地标记为权威终态",true
  r416,"role-or-prefix-protects-sink","图中 conclusion 带 role=conclusion（或 node_conclusion_ 前缀）","用户查看剪枝入口","结论节点不可作为可剪枝研究支路入口（与服务端保护一致）",true
  r417,"accept-prune-proposal-calls-api","节点 chat 展示 pending prune 提案","用户点击接受","客户端调用 POST prune（而非只改本地节点状态）",true
  r418,"canvas-pref-does-not-call-graph-api","用户切换画布布局方向或小地图","偏好生效","未因此发出修改 research graph 的命令口请求",true
  r419,"restore-revision-refreshes-graph","用户选择恢复某 revision","恢复成功","画布与报告反映该快照内容（经 GET 或 graph_patch）",true
