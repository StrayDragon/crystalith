default:
    @just -l

install:
    pnpm install

ensure-deps:
    bash ../../scripts/ensure_frontend_web_ready.sh

dev: ensure-deps
    pnpm dev

preview: ensure-deps
    pnpm preview

build: ensure-deps
    pnpm run build

test: ensure-deps
    pnpm run test:ci

typecheck: ensure-deps
    pnpm run typecheck
