{
  "name": "crystalith-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "vite",
    "predev": "bash ../../scripts/ensure_frontend_web_ready.sh",
    "dev": "vite",
    "prebuild": "bash ../../scripts/ensure_frontend_web_ready.sh",
    "build": "vite build",
    "prepreview": "bash ../../scripts/ensure_frontend_web_ready.sh",
    "preview": "vite preview",
    "pretest": "bash ../../scripts/ensure_frontend_web_ready.sh",
    "lint": "echo 'crystalith-web lint is managed by root; run bun lint from repo root'",
    "lint:all": "echo 'crystalith-web lint:all is managed by root; run bun lint from repo root'",
    "test": "vitest",
    "pretest:ci": "bash ../../scripts/ensure_frontend_web_ready.sh",
    "test:ci": "bun run test-mock-report-check && TZ=UTC VITEST_MSW_ON_UNHANDLED=error vitest run",
    "pretest:core": "bash ../../scripts/ensure_frontend_web_ready.sh",
    "test:core": "bun run test-mock-report-check && TZ=UTC VITEST_MSW_ON_UNHANDLED=error node ./scripts/core_suite.mjs run",
    "pretest:all": "bash ../../scripts/ensure_frontend_web_ready.sh",
    "test:all": "VITEST_INCLUDE_EXPERIMENTAL=1 VITEST_MSW_ON_UNHANDLED=warn vitest run",
    "test-mock-report": "node ./scripts/test_mock_report.mjs",
    "test-mock-report-check": "node ./scripts/test_mock_report.mjs --check-mock-reasons",
    "pretypecheck": "bash ../../scripts/ensure_frontend_web_ready.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "echo 'crystalith-web format is managed by root; run bun format from repo root'",
    "format:check": "echo 'crystalith-web format:check is managed by root; run bun format:check from repo root'"
  },
  "dependencies": {
    "@emotion/react": "^11.13.5",
    "@emotion/styled": "^11.13.5",
    "@material-tailwind/react": "^2.1.10",
    "@mui/icons-material": "^7.3.7",
    "@mui/material": "^7.3.11",
    "@platejs/basic-nodes": "^53.0.0",
    "@platejs/comment": "^53.0.0",
    "@platejs/footnote": "^53.0.0",
    "@platejs/indent": "^53.0.0",
    "@platejs/list": "^53.1.3",
    "@platejs/markdown": "^53.2.2",
    "@streamdown/code": "^1.1.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^13.5.0",
    "@xyflow/react": "^12.10.0",
    "elkjs": "^0.12.0",
    "gridstack": "^12.4.2",
    "jspdf": "^4.1.0",
    "nunjucks": "^3.2.4",
    "platejs": "^53.2.4",
    "pptxgenjs": "^4.0.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-virtuoso": "^4.18.1",
    "remark-gfm": "^4.0.1",
    "streamdown": "^2.6.0",
    "swr": "^2.3.6",
    "zod": "^4.3.6",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@crystalith/server": "workspace:*",
    "@crystalith/shared": "workspace:*",
    "@elysiajs/eden": "^1.4.9",
    "@types/node": "^22.18.6",
    "@types/nunjucks": "^3.2.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.23",
    "jsdom": "^26.1.0",
    "msw": "^2.12.10",
    "postcss": "^8.5.6",
    "tailwind-scrollbar": "^3.1.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^7",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "packageManager": "bun@1.4.0"
}
