{
  "name": "crystalith-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "rsbuild dev",
    "predev": "bash ../../scripts/ensure_frontend_web_ready.sh",
    "dev": "rsbuild dev",
    "prebuild": "bash ../../scripts/ensure_frontend_web_ready.sh",
    "build": "rsbuild build",
    "prepreview": "bash ../../scripts/ensure_frontend_web_ready.sh",
    "preview": "rsbuild preview",
    "pretest": "bash ../../scripts/ensure_frontend_web_ready.sh",
    "lint": "echo 'crystalith-web lint is managed by root; run bun lint from repo root'",
    "lint:all": "echo 'crystalith-web lint:all is managed by root; run bun lint from repo root'",
    "test": "rstest",
    "pretest:ci": "bash ../../scripts/ensure_frontend_web_ready.sh",
    "test:ci": "bun run test-mock-report-check && TZ=UTC RSTEST_MSW_ON_UNHANDLED=error rstest run --reporter=dot --silent passed-only --hideSkippedTestFiles",
    "pretest:core": "bash ../../scripts/ensure_frontend_web_ready.sh",
    "test:core": "bun run test-mock-report-check && TZ=UTC RSTEST_MSW_ON_UNHANDLED=error node ./scripts/core_suite.mjs run",
    "pretest:all": "bash ../../scripts/ensure_frontend_web_ready.sh",
    "test:all": "RSTEST_INCLUDE_EXPERIMENTAL=1 RSTEST_MSW_ON_UNHANDLED=warn rstest run",
    "test-mock-report": "node ./scripts/test_mock_report.mjs",
    "test-mock-report-check": "node ./scripts/test_mock_report.mjs --check-mock-reasons",
    "pretypecheck": "bash ../../scripts/ensure_frontend_web_ready.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "echo 'crystalith-web format is managed by root; run bun format from repo root'",
    "format:check": "echo 'crystalith-web format:check is managed by root; run bun format:check from repo root'"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@platejs/basic-nodes": "^53.0.0",
    "@platejs/footnote": "^53.0.0",
    "@platejs/indent": "^53.0.0",
    "@platejs/list": "^53.3.13",
    "@platejs/markdown": "^53.3.17",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@streamdown/code": "^2.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@xyflow/react": "^12.12.0",
    "elkjs": "^0.12.0",
    "gridstack": "^14.0.0",
    "jspdf": "^4.2.1",
    "platejs": "^53.3.15",
    "pptxgenjs": "^4.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-virtuoso": "^4.18.19",
    "remark-gfm": "^4.0.1",
    "streamdown": "^2.7.0",
    "swr": "^2.5.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@crystalith/server": "workspace:*",
    "@crystalith/shared": "workspace:*",
    "@elysiajs/eden": "^1.4.9",
    "@rsbuild/core": "^2.2.13",
    "@rsbuild/plugin-react": "^2.1.1",
    "@rstest/adapter-rsbuild": "^0.12.3",
    "@rstest/core": "^0.12.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "packageManager": "bun@1.4.3"
}
