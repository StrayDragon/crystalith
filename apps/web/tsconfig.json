{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "types": ["vitest/globals", "@testing-library/jest-dom"],
    "paths": {
      "*": ["./*"],
      "@brand/*": ["../../assets/*"],
      "@crystalith-slidev": ["../../packages/crystalith-slidev/src/index.ts"],
      "@crystalith-slidev/*": ["../../packages/crystalith-slidev/src/*"]
    }
  },
  "include": ["src", "../../packages/crystalith-slidev/src"]
}
