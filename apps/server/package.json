{
  "name": "@crystalith/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/server.ts",
    "./app": "./src/server.ts"
  },
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "build": "bun scripts/build-binary.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "echo '@crystalith/server lint is managed by root; run bun lint from repo root'",
    "format": "echo '@crystalith/server format is managed by root; run bun format from repo root'",
    "format:check": "echo '@crystalith/server format:check is managed by root; run bun format:check from repo root'",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.78",
    "@ai-sdk/deepseek": "^3.0.63",
    "@ai-sdk/google": "^4.0.93",
    "@ai-sdk/openai": "^4.0.91",
    "@ai-sdk/openai-compatible": "^3.0.67",
    "@ai-sdk/provider": "^4.0.26",
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@crystalith/shared": "workspace:*",
    "@cucumber/gherkin": "^41.0.0",
    "@elysiajs/eden": "^1.4.9",
    "@elysiajs/openapi": "^1.4.16",
    "@mozilla/readability": "^0.6.0",
    "ai": "^7.0.137",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.4",
    "elysia": "^1.4.30",
    "gpt-tokenizer": "^4.0.0",
    "jsdom": "^30.0.0",
    "sqlite-vec": "^0.1.9",
    "unpdf": "^1.6.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/jsdom": "^30.0.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7"
  }
}
