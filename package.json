{
  "name": "crystalith",
  "version": "2.0.0-dev",
  "private": true,
  "workspaces": [
    "apps/server",
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "bun --filter @crystalith/server dev",
    "dev:web": "bun --filter crystalith-web dev",
    "dev": "bun run dev:server & bun run dev:web",
    "build": "bun --filter '*' build",
    "test": "bun --filter '*' test",
    "typecheck": "bun --filter '*' typecheck",
    "lint": "oxlint",
    "lint:type-aware": "oxlint --type-aware --tsconfig tsconfig.lint.json",
    "lint:fix": "oxlint --fix",
    "format": "bun format:check",
    "format:write": "oxfmt --write",
    "format:check": "oxfmt --check",
    "check": "bun typecheck && bun lint && bun format:check",
    "fix": "bun lint:fix && bun format:write"
  },
  "dependencies": {
    "ipaddr.js": "^2.4.0",
    "private-ip": "^3.0.2"
  },
  "devDependencies": {
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "oxlint-tsgolint": "^0.24.0"
  },
  "resolutions": {
    "react": "18.2.0",
    "react-dom": "18.2.0"
  }
}
