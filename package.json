{
  "name": "crystalith",
  "version": "2.0.0-dev",
  "private": true,
  "workspaces": [
    "apps/server",
    "apps/web",
    "packages/*",
    "e2e"
  ],
  "scripts": {
    "dev:server": "cd apps/server && bun run dev",
    "dev:web": "cd apps/web && bun run dev",
    "dev": "overmind start -N -c slidev -f Procfile",
    "dev:overmind": "overmind start -N -c slidev -f Procfile",
    "dev:slidev": "cd packages/crystalith-slidev && bun run dev",
    "build": "bun --filter '*' build",
    "test": "bun --filter './apps/*' --filter './packages/*' test",
    "e2e": "cd e2e && bunx playwright test --grep @p0",
    "e2e:p0": "cd e2e && bunx playwright test --grep @p0",
    "e2e:all": "cd e2e && bunx playwright test",
    "e2e:install": "cd e2e && bunx playwright install chromium",
    "typecheck": "bun --filter './apps/*' --filter './packages/*' typecheck",
    "lint": "oxlint",
    "lint:type-aware": "oxlint --type-aware --tsconfig tsconfig.lint.json --ignore-pattern '**/*.{test,spec}.{ts,tsx}' apps/server/src apps/web/src packages/shared/src",
    "lint:fix": "oxlint --fix",
    "format": "bun format:check",
    "format:write": "oxfmt --write",
    "format:check": "oxfmt --check",
    "check": "bun typecheck && bun lint && bun format:check",
    "fix": "bun lint:fix && bun format:write"
  },
  "dependencies": {
    "ipaddr.js": "^2.4.0",
    "private-ip": "^3.0.2"
  },
  "devDependencies": {
    "@crystalith-plugin/extractor-arxiv": "workspace:*",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "oxlint-tsgolint": "^0.24.0",
    "typescript": "^7.0.2",
    "zod-to-json-schema": "^3.25.2"
  },
  "resolutions": {
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
