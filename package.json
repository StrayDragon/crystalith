{
  "name": "crystalith",
  "version": "2.0.0-dev",
  "private": true,
  "workspaces": [
    "server",
    "frontend/web",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "bun --filter @crystalith/server dev",
    "dev:web": "bun --filter crystalith-web dev",
    "build": "bun --filter '*' build",
    "test": "bun --filter '*' test",
    "typecheck": "bun --filter '*' typecheck",
    "lint": "bun --filter '*' lint",
    "format": "bun --filter '*' format",
    "format:check": "bun --filter '*' format:check"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.9",
    "@ai-sdk/deepseek": "^3.0.5",
    "@ai-sdk/google": "^4.0.9",
    "@ai-sdk/openai": "^4.0.8",
    "ai": "^7.0.17",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "gpt-tokenizer": "^3.4.0",
    "sqlite-vec": "^0.1.9"
  }
}
