from __future__ import annotations

{% if plugin_kind == "OutputType" -%}
from pydantic import BaseModel, Field

from crystalith.shared.plugins.render_types import (
    ConfigOption,
    FieldDescriptor,
    ItemSchema,
    OutputTypePluginMeta,
    PluginConfigSchema,
    RenderDescriptor,
)


class Item(BaseModel):
    text: str
    citations: list[int] = Field(default_factory=list)


class Output(BaseModel):
    items: list[Item] = Field(default_factory=list)


class Plugin:
    api_version = "v1"

    output_type = "{{ output_type }}"
    schema = Output
    default_prompt = "Describe what you want to generate."

    # ── Common extension points ──────────────────────────────────────────
    metadata = OutputTypePluginMeta(
        description="{{ description }}",
        display_text="{{ display_text }}",
        tone="{{ tone }}",
    )

    render_descriptor = RenderDescriptor(
        layout="list",
        item_schema=ItemSchema(
            fields=[
                FieldDescriptor(key="text", type="text", label="Text"),
                FieldDescriptor(key="citations", type="citation", label=None),
            ]
        ),
        options={"items_key": "items"},
    )

    config_schema = PluginConfigSchema(
        quantity_options=[
            ConfigOption(id="standard", label="Standard", is_default=True),
        ],
        difficulty_options=[],
        topic_placeholder="Topic (optional)",
        supports_topic=True,
    )


plugin = Plugin()
{%- else -%}
from collections.abc import AsyncIterator, Sequence
from typing import Any


class ChatProvider:
    provider = "{{ plugin_id }}"

    def __init__(self, model: str) -> None:
        self.model = model

    async def chat(self, messages: Sequence[Any]) -> str:
        raise NotImplementedError

    async def chat_stream(self, messages: Sequence[Any]) -> AsyncIterator[str]:
        yield await self.chat(messages)


class EmbeddingProvider:
    provider = "{{ plugin_id }}"

    def __init__(self, model: str) -> None:
        self.model = model

    async def embed(self, texts: Sequence[str]) -> list[list[float]]:
        raise NotImplementedError

    async def embed_batch(
        self,
        texts: Sequence[str],
        *,
        batch_size: int = 100,
    ) -> list[list[float]]:
        raise NotImplementedError


class Plugin:
    api_version = "v1"

    def create_chat_provider(self, settings: Any, model_config: Any) -> ChatProvider:
        return ChatProvider(model=str(getattr(model_config, "model", "")))

    def create_embedding_provider(self, settings: Any, model_config: Any) -> EmbeddingProvider:
        return EmbeddingProvider(model=str(getattr(model_config, "model", "")))


plugin = Plugin()
{%- endif %}
