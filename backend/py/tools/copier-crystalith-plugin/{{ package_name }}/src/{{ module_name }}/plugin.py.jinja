from __future__ import annotations

{% if plugin_kind == "OutputType" %}

from pydantic import BaseModel, Field

from crystalith.shared.plugins.render_types import (
    ConfigOption,
    FieldDescriptor,
    ItemSchema,
    OutputTypePluginMeta,
    PluginConfigSchema,
    RenderDescriptor,
)


class MyItem(BaseModel):
    text: str
    citations: list[int] = Field(default_factory=list)


class MyOutput(BaseModel):
    items: list[MyItem] = Field(default_factory=list)


class MyPlugin:
    api_version = "v1"

    output_type = "{{ output_type }}"
    schema = MyOutput
    default_prompt = "Generate structured output from the sources."

    metadata = OutputTypePluginMeta(
        description="{{ description }}",
        display_text="{{ display_text }}",
        tone="{{ tone }}",
    )

    render_descriptor = RenderDescriptor(
        layout="list",
        item_schema=ItemSchema(
            fields=[
                FieldDescriptor(key="text", type="text", label="Text"),
                FieldDescriptor(key="citations", type="citation", label=None),
            ]
        ),
        options={"items_key": "items"},
    )

    config_schema = PluginConfigSchema(
        quantity_options=[ConfigOption(id="standard", label="Standard", is_default=True)],
        difficulty_options=[],
        topic_placeholder="Topic (optional)",
        supports_topic=True,
    )


plugin = MyPlugin()

{% else %}

from collections.abc import AsyncIterator, Sequence
from typing import Any


class MyChatProvider:
    provider = "{{ plugin_id }}"

    def __init__(self, model: str) -> None:
        self.model = model

    async def chat(self, messages: Sequence[Any]) -> str:
        last = messages[-1] if messages else {}
        content = getattr(last, "content", None)
        if content is None and isinstance(last, dict):
            content = last.get("content")
        return f"{{ plugin_id }}:{% raw %}{content or ''}{% endraw %}"

    async def chat_stream(self, messages: Sequence[Any]) -> AsyncIterator[str]:
        yield await self.chat(messages)


class MyEmbeddingProvider:
    provider = "{{ plugin_id }}"

    def __init__(self, model: str) -> None:
        self.model = model

    async def embed(self, texts: Sequence[str]) -> list[list[float]]:
        return await self.embed_batch(texts, batch_size=len(texts) or 1)

    async def embed_batch(
        self,
        texts: Sequence[str],
        *,
        batch_size: int = 100,
    ) -> list[list[float]]:
        if not texts:
            return []
        return [[float(len(text))] for text in texts]


class MyPlugin:
    api_version = "v1"

    def create_chat_provider(self, settings: Any, model_config: Any) -> MyChatProvider:
        return MyChatProvider(model=str(getattr(model_config, "model", "")))

    def create_embedding_provider(self, settings: Any, model_config: Any) -> MyEmbeddingProvider:
        return MyEmbeddingProvider(model=str(getattr(model_config, "model", "")))


plugin = MyPlugin()

{% endif %}
