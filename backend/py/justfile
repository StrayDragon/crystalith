default:
    @just -l

sync:
    uv sync

install: sync

dev:
    uv run python main.py

test:
    uv run pytest

test-cl-logs:
    uv run --project packages/cl-logs --group dev pytest packages/cl-logs/tests

db-init:
    uv run scripts/db_init.py

vector-migrate:
    uv run scripts/vector_migrate.py
