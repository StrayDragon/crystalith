default:
    @just -l

dev:
    uv run python main.py

packages-test:
    #!/bin/bash
    for package in packages/*; do
        PYTHONHASHSEED=0 TZ=UTC uv run --project $package pytest --no-cov $package/tests
    done

test: packages-test lint typecheck check-imports config-schema-check test-mock-report-check
    PYTHONHASHSEED=0 TZ=UTC uv run pytest tests/ -v -m "not experimental"

test-core: test-mock-report-check
    PYTHONHASHSEED=0 TZ=UTC uv run python scripts/core_suite.py run

test-all: test-mock-report-check
    PYTHONHASHSEED=0 TZ=UTC uv run pytest tests/ -v --no-cov

typecheck:
    uv run basedpyright --level error src

lint:
    uv run ruff check src tests

contract:
    PYTHONHASHSEED=0 TZ=UTC uv run pytest tests/contract -v --no-cov

check:
    @echo "==> Checking backend import layering"
    just check-imports
    @echo "==> Checking config schema consistency"
    just config-schema-check
    @echo "==> Running Python lint"
    just lint
    @echo "==> Running Python typecheck"
    just typecheck
    @echo "==> Running API contract tests"
    just contract

coverage: packages-test
    PYTHONHASHSEED=0 TZ=UTC uv run pytest tests/ -v -n 0 -m "not experimental" --cov=crystalith --cov-report=term --cov-fail-under=85

coverage-html: packages-test
    PYTHONHASHSEED=0 TZ=UTC uv run pytest tests/ -v -n 0 -m "not experimental" --cov=crystalith --cov-report=html --cov-fail-under=85

check-imports:
    rg --files -g '*.py' src/crystalith/features src/crystalith/shared | uv run python scripts/check_imports.py

config-schema:
    uv run python -c "from pathlib import Path; from crystalith.shared.config import ConfigManager; ConfigManager(Path('../../config/app.yaml'), schema_path=Path('../../config/app.schema.gen.json')).write_schema()"

config-schema-check:
    #!/usr/bin/env bash
    set -euo pipefail
    just config-schema
    if ! git diff --ignore-space-at-eol --exit-code -- ../../config/app.schema.gen.json; then
        echo "config/app.schema.gen.json is out of date. Run: cd backend/py && just config-schema" >&2
        exit 1
    fi

db-init:
    uv run scripts/db_init.py

db-migrate MESSAGE:
    uv run alembic revision --autogenerate -m "{{MESSAGE}}"

db-rollback:
    uv run alembic downgrade -1

llm-eval:
    uv run python scripts/llm_eval.py

embedding-cache-bench:
    uv run python scripts/embedding_cache_bench.py

test-mock-report:
    uv run python scripts/test_mock_report.py

test-mock-report-check:
    uv run python scripts/test_mock_report.py --check-private-patches --check-mock-reasons
