default:
    @just -l

dev:
    uv run python main.py

e2e-dev:
    HOST=${E2E_BACKEND_HOST:-0.0.0.0} PORT=${E2E_BACKEND_PORT:-8032} RELOAD=1 AUTO_DB_INIT=1 CRYSTALITH_DATABASE__URL=sqlite+aiosqlite:///./data/e2e.db CRYSTALITH_VECTOR_STORAGE__PROVIDER=sqlite CRYSTALITH_VECTOR_STORAGE__SQLITE__PATH=./data/vectors-e2e.db uv run python main.py
    # Optional overrides: E2E_BACKEND_HOST (default 0.0.0.0), E2E_BACKEND_PORT (default 8032)

packages-test:
    #!/bin/bash
    for package in packages/*; do
        uv run --project $package pytest $package/tests
    done

test: packages-test
    uv run pytest tests/ -v

check-imports:
    rg --files -g '*.py' src/crystalith/features src/crystalith/shared | uv run python scripts/check_imports.py

db-init:
    uv run scripts/db_init.py

db-migrate MESSAGE:
    uv run alembic revision --autogenerate -m "{{MESSAGE}}"

db-rollback:
    uv run alembic downgrade -1

vector-migrate:
    uv run scripts/vector_migrate.py

e2e-seed:
    uv run scripts/e2e_seed.py
