default:
    @just -l

dev:
    uv run python main.py

packages-test:
    #!/bin/bash
    for package in packages/*; do
        uv run --project $package pytest --no-cov $package/tests
    done

test: packages-test
    uv run pytest tests/ -v

coverage: packages-test
    uv run pytest tests/ -v -n 0 --cov=crystalith --cov-report=term --cov-fail-under=85

coverage-html: packages-test
    uv run pytest tests/ -v -n 0 --cov=crystalith --cov-report=html --cov-fail-under=85

check-imports:
    rg --files -g '*.py' src/crystalith/features src/crystalith/shared | uv run python scripts/check_imports.py

config-schema:
    uv run python -c "from pathlib import Path; from crystalith.shared.config import ConfigManager; ConfigManager(Path('../../config/app.yaml'), schema_path=Path('../../config/app.schema.json')).write_schema()"

db-init:
    uv run scripts/db_init.py

db-migrate MESSAGE:
    uv run alembic revision --autogenerate -m "{{MESSAGE}}"

db-rollback:
    uv run alembic downgrade -1

vector-migrate:
    uv run scripts/vector_migrate.py

llm-eval:
    uv run python scripts/llm_eval.py

embedding-cache-bench:
    uv run python scripts/embedding_cache_bench.py
