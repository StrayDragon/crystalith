default:
    @just -l

dev:
    uv run python main.py

e2e-dev:
    HOST=0.0.0.0 PORT=8032 RELOAD=1 AUTO_DB_INIT=1 CRYSTALITH_DATABASE__URL=sqlite+aiosqlite:///./data/e2e.db CRYSTALITH_VECTOR_STORAGE__PROVIDER=sqlite CRYSTALITH_VECTOR_STORAGE__SQLITE__PATH=./data/vectors-e2e.db uv run python main.py

packages-test:
    #!/bin/bash
    for package in packages/*; do
        uv run --project $package pytest $package/tests
    done

test: packages-test
    uv run pytest tests/ -v

check-imports:
    rg --files -g '*.py' src/crystalith/features src/crystalith/shared | uv run python scripts/check_imports.py

db-init:
    uv run scripts/db_init.py

vector-migrate:
    uv run scripts/vector_migrate.py

e2e-seed:
    uv run scripts/e2e_seed.py
