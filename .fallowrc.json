{
  // This file is JSONC: fallow reads these comments; generic JSON tools may not.
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    // 各 workspace 由插件自动识别；此处补齐 CLI/构建/CI 辅助脚本入口
    "scripts/*.{ts,js}",
    "e2e/*.{ts,js}",
    "apps/web/scripts/*.{js,ts}",
    "apps/web/rstest.setup.ts",
    "apps/web/src/test-utils/**/*.{ts,tsx}"
  ],
  "workspaces": {
    "patterns": ["apps/server", "apps/web", "packages/*", "e2e"]
  },
  "duplicates": {
    // Hide pair-only clones; focus on widespread copy-paste
    // worth refactoring. Lower to 2 to report every duplicate pair.
    "minOccurrences": 3
    // Common additions (uncomment to enable):
    // "ignore": [
    //   "**/lib/**",          // for repos that publish transpiled output to lib/
    //   "**/legacy/**",       // for repos with legacy-build artifacts
    //   "**/__generated__/**", // Relay, GraphQL Code Generator
    //   "**/generated/**"     // OpenAPI, Protobuf codegen
    // ]
  },
  "rules": {
    "unused-dependencies": "warn"
  },
  // 动态 import() 的 provider SDK 与跨 workspace Eden treaty 均无法静态追踪
  "ignoreDependencies": [
    "@ai-sdk/anthropic",
    "@ai-sdk/deepseek",
    "@ai-sdk/google",
    "@ai-sdk/openai",
    "@ai-sdk/openai-compatible",
    "@elysiajs/eden"
  ],

  "ignoreExports": [
    {
      "file": "apps/web/src/features/workspace/domains/sources/sourceDetailTypes.ts",
      "exports": ["*"]
    },
    {
      "file": "apps/web/src/features/workspace/shared/types.ts",
      "exports": ["*"]
    },
    {
      "file": "apps/web/src/plugins/official/output-briefing/index.tsx",
      "exports": ["*"]
    },
    {
      "file": "apps/web/src/plugins/official/output-faq/index.tsx",
      "exports": ["*"]
    },
    {
      "file": "apps/web/src/plugins/official/output-guide/index.tsx",
      "exports": ["*"]
    },
    {
      "file": "apps/web/src/plugins/official/output-mindmap/index.tsx",
      "exports": ["*"]
    },
    {
      "file": "apps/web/src/plugins/official/output-quiz/index.tsx",
      "exports": ["*"]
    },
    {
      "file": "apps/web/src/plugins/official/output-slides/index.tsx",
      "exports": ["*"]
    },
    {
      "file": "apps/web/src/plugins/official/output-timeline/index.tsx",
      "exports": ["*"]
    }
  ]
}
